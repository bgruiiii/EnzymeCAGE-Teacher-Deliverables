  "properties": {
    "schema_version": {
      "const": "biodegradation_answer_v2"
    },
    "case_id": {
      "type": "string",
      "pattern": "^BIOPATH150_[0-9]{3}$"
    },
    "pollutant_name_zh": {
      "type": "string",
      "minLength": 1
    },
    "pollutant_name_en": {
      "type": "string",
      "minLength": 1
    },
    "route_scope": {
      "$ref": "#/definitions/routeScope"
    },
    "route_summary": {
      "type": [
        "string",
        "null"
      ]
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/step"
      }
    },
    "organism_profiles": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/organismProfile"
      }
    },
    "complete_pathway_organism_profile_id": {
      "type": [
        "string",
        "null"
