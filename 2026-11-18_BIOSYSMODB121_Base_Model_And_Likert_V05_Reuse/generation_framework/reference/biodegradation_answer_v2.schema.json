{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://enzymecage.local/schemas/biodegradation_answer_v2.schema.json",
  "title": "Biodegradation pathway model answer v2",
  "description": "Engineering answer-collection schema v2 (authority: BIOSYSMODB150_API_ANSWER_COLLECTION_EXECUTION_PLAN_2026-09-26.md sections 6, 9 and 11). Format conformance is recorded as an experimental observation only; a schema failure never deletes, rewrites or re-questions a model answer.",
  "type": "object",
  "required": [
    "schema_version",
    "case_id",
    "pollutant_name_zh",
    "pollutant_name_en",
    "route_scope",
    "route_summary",
    "steps",
    "organism_profiles",
