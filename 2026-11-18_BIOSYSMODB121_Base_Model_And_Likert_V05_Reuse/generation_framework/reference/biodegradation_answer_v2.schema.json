        "type": "object",
        "required": [
          "name",
          "summary"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "summary": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "alternative_branches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "summary",
          "is_part_of_scored_main_route"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "summary": {
            "type": [
              "string",
              "null"
