@@ -0,0 +1,227 @@
+# -*- coding: utf-8 -*-
+"""T6-R3A-R2A §6：冻结 reviewed UID map lazy loader 的 fresh 进程用例执行器。
+
+由 tests/test_t6r3ar2a_frozen_uid_map_loader.py 逐用例调用（每用例一个进程 ⇒ 进程级
+lazy cache 隔离）。全程不访问公网、不复制 104MB 表；小表用例只在临时目录里构造几 KB
+合成 CSV，并按需要临时改写模块级冻结常量（进程退出即消失）以覆盖 bytes/SHA/文件名/
+CSV schema 各道身份门。stdout 输出 JSON 结果。
+"""
+import csv
+import hashlib
+import json
+import os
+import sys
+import tempfile
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+for p in (str(ROOT), str(ROOT / "tests")):
+    if p not in sys.path:
+        sys.path.insert(0, p)
+
+import _t6r3ar2a_support as S  # noqa: E402
+from src.tools import microbe_recommender as MR  # noqa: E402
+
+CASE = (os.environ.get("R2A_LOADER_CASE") or "").strip()
+HEADER = list(MR.FROZEN_UID_MAP_REQUIRED_COLUMNS) + ["extra_column"]
+IDX = {name: i for i, name in enumerate(HEADER)}
+
+
+def _row(uid, taxid="100", name="Testus organismus", reviewed="reviewed",
+         sig=None, level="proteome", ambiguous="0", confidence="high", source_db="UniProtKB+Proteomes"):
+    row = [""] * len(HEADER)
+    row[IDX["UniprotID"]] = uid
+    row[IDX["TaxID"]] = str(taxid)
+    row[IDX["organism_name"]] = name
+    row[IDX["reviewed"]] = reviewed
+    row[IDX["source_signature"]] = sig if sig is not None else f"taxon:{taxid}|organism:{name.casefold()}"
+    row[IDX["source_resolution_level"]] = level
+    row[IDX["mapping_confidence"]] = confidence
+    row[IDX["is_ambiguous"]] = ambiguous
+    row[IDX["source_db"]] = source_db
+    row[IDX["extra_column"]] = "x"
+    return row
+
+
+def _write_table(dirpath, rows, basename=None, header=None):
+    path = Path(dirpath) / (basename or MR.FROZEN_UID_MAP_BASENAME)
+    with open(str(path), "w", newline="", encoding="utf-8") as fh:
+        writer = csv.writer(fh)
+        writer.writerow(header if header is not None else HEADER)
+        for row in rows:
+            writer.writerow(row)
+    return path
+
+
+def _patch_identity_to(path):
+    """把模块级 bytes/SHA 常量临时指向小表，以便单独考察后续门（文件名/schema/行级）。"""
+    digest = S.sha256_file(path)
+    MR.FROZEN_UID_MAP_BYTES = os.path.getsize(str(path))
+    MR.FROZEN_UID_MAP_SHA256 = digest
+
+
+def _stats():
+    st = MR.frozen_map_cache_stats()
+    return {k: st[k] for k in ("env_configured", "gate_error", "table_sha256", "open_count",
+                               "scan_count", "full_scan_done", "indexed_uids",
+                               "line_read_count", "cached_row_uids",
+                               "cached_queried_uids")}
+
+
+def case_gate_unset():
+    os.environ.pop(MR.FROZEN_UID_MAP_ENV_VAR, None)
+    rows, errors, gate = MR.frozen_map_host_identity(["Q7X2D3"])
+    # 第二次调用不得重新核身份（错误也被进程级缓存）
+    rows2, errors2, gate2 = MR.frozen_map_host_identity(["A0A075BSX9"])
+    return {"rows": rows, "errors": errors, "gate_error": gate, "second_gate_error": gate2,
+            "stats": _stats()}
+
+
+def case_gate_missing():
+    os.environ[MR.FROZEN_UID_MAP_ENV_VAR] = "/nonexistent/r2a/definitely_absent.csv"
+    rows, errors, gate = MR.frozen_map_host_identity(["Q7X2D3"])
+    return {"gate_error": gate, "stats": _stats()}
+
+
+def case_gate_symlink():
+    tmp = tempfile.mkdtemp(prefix="r2a_gate_")
+    real = _write_table(tmp, [_row("U1")])
+    link = Path(tmp) / "uid_link.csv"
+    os.symlink(str(real), str(link))
+    _patch_identity_to(link)
+    os.environ[MR.FROZEN_UID_MAP_ENV_VAR] = str(link)
+    rows, errors, gate = MR.frozen_map_host_identity(["U1"])
+    return {"gate_error": gate, "rows": rows, "stats": _stats()}
+
+
+def case_gate_size():
+    tmp = tempfile.mkdtemp(prefix="r2a_gate_")
+    _write_table(tmp, [_row("U1")])          # 几字节 << 冻结 bytes
+    os.environ[MR.FROZEN_UID_MAP_ENV_VAR] = str(Path(tmp) / MR.FROZEN_UID_MAP_BASENAME)
+    rows, errors, gate = MR.frozen_map_host_identity(["U1"])
+    return {"gate_error": gate, "stats": _stats()}
+
+
+def case_gate_sha():
+    tmp = tempfile.mkdtemp(prefix="r2a_gate_")
+    path = _write_table(tmp, [_row("U1")])
+    MR.FROZEN_UID_MAP_BYTES = os.path.getsize(str(path))   # 越过 bytes 门 → 落到 SHA 门
+    os.environ[MR.FROZEN_UID_MAP_ENV_VAR] = str(path)
+    rows, errors, gate = MR.frozen_map_host_identity(["U1"])
+    return {"gate_error": gate, "frozen_sha": MR.FROZEN_UID_MAP_SHA256, "stats": _stats()}
+
+
+def case_gate_basename():
+    tmp = tempfile.mkdtemp(prefix="r2a_gate_")
+    path = _write_table(tmp, [_row("U1")], basename="some_other_table.csv")
+    _patch_identity_to(path)
+    os.environ[MR.FROZEN_UID_MAP_ENV_VAR] = str(path)
+    rows, errors, gate = MR.frozen_map_host_identity(["U1"])
+    return {"gate_error": gate, "stats": _stats()}
+
+
+def case_gate_schema():
+    tmp = tempfile.mkdtemp(prefix="r2a_gate_")
+    bad_header = [c for c in HEADER if c != "source_signature"]
+    keep = [i for i, name in enumerate(HEADER) if name != "source_signature"]
+    path = _write_table(tmp, [[_row("U1")[i] for i in keep]], header=bad_header)
+    _patch_identity_to(path)
+    os.environ[MR.FROZEN_UID_MAP_ENV_VAR] = str(path)
+    rows, errors, gate = MR.frozen_map_host_identity(["U1"])
+    return {"gate_error": gate, "stats": _stats()}
+
+
+def case_scan_rows():
+    """行级判定 + 一次性扫描 + 负缓存（§6 全八步）。"""
+    tmp = tempfile.mkdtemp(prefix="r2a_scan_")
+    rows = [
+        _row("U1"),                                              # 合法 proteome → EXACT_STRAIN
+        _row("U2", taxid="200", name="Species testis", level="taxon_organism"),   # → SPECIES
+        _row("U3", reviewed="unreviewed"),
+        _row("U4", ambiguous="1"),
+        _row("U5", sig="uniprotkb_reviewed:U5"),
+        _row("U6", level="galaxy_cluster"),
+        _row("U7", taxid="0"),
+        _row("D1", taxid="300", sig="proteome:UP000000001"),
+        _row("D1", taxid="300", sig="taxon:300|organism:dup one"),
+        _row("E1", taxid="400", sig="proteome:UP000000002"),
+        _row("E1", taxid="400", sig="proteome:UP000000002"),
+    ]
+    path = _write_table(tmp, rows)
+    _patch_identity_to(path)
+    os.environ[MR.FROZEN_UID_MAP_ENV_VAR] = str(path)
+    # 第一批（含合法 + 非法 + 缺失），第二批复用同一进程缓存；整表只扫一次
+    r1, e1, g1 = MR.frozen_map_host_identity(["U1", "U2", "U3", "U4"])
+    mid = _stats()
+    r2, e2, g2 = MR.frozen_map_host_identity(
+        ["U5", "U6", "U7", "D1", "E1", "NOT_IN_TABLE", "U1", "U2"])
+    after = _stats()
+    # 第三批全部是已查过的 UID（含缺行 UID）⇒ 不得再产生任何行回读
+    r3, e3, g3 = MR.frozen_map_host_identity(["U1", "U2", "NOT_IN_TABLE"])
+    rows_out = {}
+    for uid, row in list(r1.items()) + list(r2.items()):
+        rows_out[uid] = row
+    return {"gate_error": g1 or g2 or g3, "first_errors": e1, "second_errors": e2,
+            "third_errors": e3, "third_rows": sorted(r3),
+            "rows": rows_out, "stats_mid": mid, "stats": after,
+            "stats_after_repeat": _stats(),
+            "expected_table_sha": hashlib.sha256(path.read_bytes()).hexdigest()}
+
+
+def case_real_table():
+    """真实 104MB 冻结表：4 个本任务 UID 的已审计签名/行号/行 SHA + 一次性扫描 + 缺行负缓存。"""
+    path = S.uid_map_path()
+    if path is None:
+        return {"skipped": "frozen reviewed UID map not available"}
+    os.environ[MR.FROZEN_UID_MAP_ENV_VAR] = str(path)
+    first = S.UIDS[:2]
+    rows1, errors1, gate1 = MR.frozen_map_host_identity(first)
+    mid = _stats()
+    second = S.UIDS[2:] + ["R2ASYNTH00ABSENT"]
+    rows2, errors2, gate2 = MR.frozen_map_host_identity(second)
+    after = _stats()
+    # 重复查询本进程已解析过的 UID ⇒ 零新增开表/扫描/行回读
+    rows3, errors3, gate3 = MR.frozen_map_host_identity(S.UIDS[:1])
+    rows = {}
+    rows.update(rows1)
+    rows.update(rows2)
+    # 独立复算目标行 bytes 的 SHA256（不经 loader），证明 row hash 是真实原始行摘要
+    want = {S.MAP_HOST_IDENTITY[u]["line"]: u for u in S.UIDS}
+    recomputed = {}
+    with open(str(path), "rb") as fh:
+        for line_no, raw in enumerate(fh, start=1):
+            uid = want.get(line_no)
+            if uid:
+                recomputed[uid] = hashlib.sha256(raw).hexdigest()
+            if line_no > max(want):
+                break
+    return {"gate_error": gate1 or gate2 or gate3, "rows": rows, "first_errors": errors1,
+            "second_errors": errors2, "stats_mid": mid, "stats": after,
+            "stats_after_repeat": _stats(),
+            "independent_line_no": {k: v["line"] for k, v in S.MAP_HOST_IDENTITY.items()},
+            "row_sha_recomputed_outside_loader": recomputed,
+            "basename": path.name}
+
+
+CASES = {
+    "gate_unset": case_gate_unset,
+    "gate_missing": case_gate_missing,
+    "gate_symlink": case_gate_symlink,
+    "gate_size": case_gate_size,
+    "gate_sha": case_gate_sha,
+    "gate_basename": case_gate_basename,
+    "gate_schema": case_gate_schema,
+    "scan_rows": case_scan_rows,
+    "real_table": case_real_table,
+}
+
+
+def main():
+    if CASE not in CASES:
+        raise SystemExit("unknown R2A_LOADER_CASE: " + repr(CASE))
+    sys.stdout.write(json.dumps({"case": CASE, "result": CASES[CASE]()},
+                                ensure_ascii=False, indent=1))
+
+
+if __name__ == "__main__":
+    main()
