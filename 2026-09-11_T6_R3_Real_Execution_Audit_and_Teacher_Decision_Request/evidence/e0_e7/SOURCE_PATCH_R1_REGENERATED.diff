+
+def _host_identity_signature(uid: str) -> str:
+    """T6-R3A-R2A §5：宿主 identity 签名（确定性 taxon|organism 构造形态）。
+
+    原 R1 fixture 用 ``uniprotkb_reviewed:<enzyme_uid>`` —— 那正是 R2A §5 明令禁止、
+    且冻结 G-SCHEMA organismAggregate 合并主键所依赖的酶 UID 冒充宿主形态（根因 C），
+    故本文件随 R2A 一并更新（§11 允许的「对应 tests」增量面）。
+    """
+    taxon, name = FROZEN_HOSTS[uid]["taxon"], FROZEN_HOSTS[uid]["name"]
+    return f"taxon:{taxon}|organism:{' '.join(name.split()).casefold()}"
+
+
+def _reviewed_record(uid: str, resolution: str = "SPECIES", **overrides) -> HostEvidenceRecord:
+    h = FROZEN_HOSTS[uid]
+    kwargs = dict(
+        enzyme_uid=uid,
+        source_signature=_host_identity_signature(uid),
+        host_taxid=h["taxon"],
+        host_name=h["name"],
+        host_resolution=resolution,
+        host_evidence_source=["UNIPROT_REVIEWED"],
+        source_record_id=uid,
+        evidence_hash=h["sha"],
+    )
+    kwargs.update(overrides)
+    return HostEvidenceRecord(**kwargs)
+
