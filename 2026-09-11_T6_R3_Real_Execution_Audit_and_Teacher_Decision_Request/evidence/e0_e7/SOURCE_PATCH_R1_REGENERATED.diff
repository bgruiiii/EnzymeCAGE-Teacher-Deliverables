+# ── 冻结 G-SCHEMA（THREE_MODULE_EVIDENCE_CHAIN_SCHEMA V0.1 2026-09-05）──
+GS_TARBALL = Path(
+    "/usrdata/EnzymeCAGE_data/EnzymeCAGE-master/HPC_Inputs/"
