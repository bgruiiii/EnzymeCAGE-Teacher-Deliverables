+# -*- coding: utf-8 -*-
+"""T6-R3A-R2A 测试共享支撑：冻结实物定位 + transport 注入 + 子进程运行器 + G-SCHEMA 校验。
+
+纪律（任务书 §3/§6/§10）：
+- 绝不访问公网：transport 一律注入 R3A-R1 冻结 raw bytes，或抛可控网络错误；
+- 冻结 reviewed UID map 只按项目既有 C8_UID_SOURCE_MAP_PATH 部署约定读取，不复制进仓库；
+- 冻结 G-SCHEMA 按实物 SHA 定位（工作区副本优先，其次从 canonical 归档解到 temp），
+  不修改 schema 本身。
+"""
+import hashlib
+import json
+import os
+import subprocess
+import sys
+import tarfile
+import tempfile
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+if str(ROOT) not in sys.path:
+    sys.path.insert(0, str(ROOT))
+
+UIDS = ["Q7X2D3", "A0A075BSX9", "A0A017SP50", "A0A011QK89"]
+
+# ── 2026-09-09 冻结 live raw response（R3A-R1 交付实物；本任务不重新联网）──
+RAW_DIR_FALLBACKS = [
+    Path("/usrdata/EnzymeCAGE_data/workspaces/"
+         "enzymecage_three_module_t6_r3a_r2a_microbe_node_output_uid_map_fallback_host_"
+         "signature_correction_20260909/frozen_raw"),
+    Path("/usrdata/EnzymeCAGE_data/EnzymeCAGE-master/HPC_Returned_Result_Summaries/"
+         "enzymecage_three_module_t6_r3a_r1_uniprot_host_provenance_runtime_wiring_delivery_"
+         "correction_20260909/uniprot_raw"),
+]
+RAW_SHA256 = {
+    "Q7X2D3": "3f9e0d84b760cee75c3a9cadb19d911ae0f6e187ed1f62fa694fcc9863df6121",
+    "A0A075BSX9": "b2f36ac98ed3c80b22b25f210f7ff59f189eb7d28c9d7be72b030d7e8a2a407f",
+    "A0A017SP50": "63813f5f079261d76363de89cc29c5c2188aef26ba239a9ab5d9a5252d0d6288",
+    "A0A011QK89": "d43c34a83cc59df5d972d87888856663e43e95a5c432cc91625194fde32f5cce",
+}
+# live response 中的宿主事实（§7 Path L 必须与 raw 一致）
+LIVE_HOSTS = {
+    "Q7X2D3": (37930, "Glutamicibacter protophormiae"),
+    "A0A075BSX9": (879274, "Shinella sp. (strain HZN7)"),
+    "A0A017SP50": (1388766, "Aspergillus ruber (strain CBS 135680)"),
+    "A0A011QK89": (522306, "Accumulibacter regalis"),
+}
+
+# ── 冻结 reviewed UID map（104MB，只读引用，不入包）──
+UID_MAP_PATH_FALLBACK = Path(
+    "/usrdata/EnzymeCAGE_data/EnzymeCAGE-master/HPC_Returned_Result_Summaries/"
+    "enzymecage_m4b_c8_1_lookup_index_delta_review_dependency_payload_rerun1_20260820/"
+    "_input_payload/enzymecage_m4b_c8_1_dependency_payload_20260820/inputs/uid_to_source/"
+    "uid_to_source_keep_bacteria_fungi_archaea.csv"
+)
+UID_MAP_BASENAME = "uid_to_source_keep_bacteria_fungi_archaea.csv"
+UID_MAP_BYTES = 104025134
+UID_MAP_SHA256 = "7b92e8e625cb73f070c8e902687ea5bbdbf749f04a19828e550e3fe205684fe6"
+# §5 权威宿主 identity（冻结 map 已审计签名 + 由 level 推得的 identity-resolution）
+MAP_HOST_IDENTITY = {
+    "Q7X2D3": {
+        "line": 145180, "taxid": 37930, "host_resolution": "SPECIES",
+        "source_signature": (
+            "taxon:37930|organism:glutamicibacter protophormiae "
+            "(brevibacterium protophormiae)"
+        ),
+        "map_organism_name": "Glutamicibacter protophormiae (Brevibacterium protophormiae)",
+    },
+    "A0A075BSX9": {
+        "line": 23, "taxid": 879274, "host_resolution": "SPECIES",
+        "source_signature": "taxon:879274|organism:shinella sp. (strain hzn7)",
+        "map_organism_name": "Shinella sp. (strain HZN7)",
+    },
+    "A0A017SP50": {
+        "line": 4, "taxid": 1388766, "host_resolution": "EXACT_STRAIN",
+        "source_signature": "proteome:UP000019804",
+        "map_organism_name": "Aspergillus ruber (strain CBS 135680)",
+    },
