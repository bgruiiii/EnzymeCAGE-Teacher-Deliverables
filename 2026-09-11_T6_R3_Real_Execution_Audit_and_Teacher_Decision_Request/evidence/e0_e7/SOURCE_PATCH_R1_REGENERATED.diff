+def _reviewed_evidence(uid: str) -> UniProtReviewedHostEvidence:
+    h = FROZEN_HOSTS[uid]
+    return UniProtReviewedHostEvidence(
+        source_url=UNIPROT_URL.format(uid=uid),
+        response_sha256=h["sha"],
+        primary_accession=uid,
+        entry_type="UniProtKB reviewed (Swiss-Prot)",
+        reviewed=True,
+        scientific_organism_name=h["name"],
+        ncbi_taxon_id=h["taxon"],
+        lineage=[],
+        annotation_score=h["annotation_score"],
+        protein_existence=h["protein_existence"],
+    )
