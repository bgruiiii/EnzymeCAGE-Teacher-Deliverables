+# -*- coding: utf-8 -*-
+"""T6-R3A-R2A §10：冻结 G-SCHEMA hostEvidence 子对象正负验证（schema 本体不改、不复制）。
+
+正例来自 production producer（build_host_evidence_record 的 live / fallback 两条分支 +
+UNRESOLVED 分支）输出的九字段投影；负例是**故意**破坏约束的副本，必须被冻结 schema 拒绝。
+"""
+import hashlib
+import json
+import sys
+import unittest
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+for p in (str(ROOT), str(ROOT / "tests")):
+    if p not in sys.path:
+        sys.path.insert(0, p)
+
+import _t6r3ar2a_support as S  # noqa: E402
+import jsonschema  # noqa: E402
+from src.schemas import evidence as EV  # noqa: E402
+from src.tools import microbe_recommender as MR  # noqa: E402
+
+SHA_OK = "0" * 63 + "a"
+
+
+def _live_dump():
+    up = EV.UniProtReviewedHostEvidence(
+        source_url="https://rest.uniprot.org/uniprotkb/Q7X2D3.json",
+        response_sha256=SHA_OK, primary_accession="Q7X2D3",
+        entry_type="UniProtKB reviewed (Swiss-Prot)",
+        scientific_organism_name="Glutamicibacter protophormiae", ncbi_taxon_id=37930,
+        lineage=["Bacteria"], annotation_score=5.0,
+        protein_existence="1: evidence at protein level")
+    prov = EV.EnzymeSourceProvenance(
+        enzyme_uid="Q7X2D3", uniprot_reviewed=up,
+        resolution_route="LIVE_UNIPROT_REVIEWED",
+        host_identity_source="FROZEN_REVIEWED_UID_MAP",
+        host_identity_source_signature="taxon:37930|organism:glutamicibacter protophormiae",
+        host_resolution="SPECIES", host_taxid=37930,
+        host_name="Glutamicibacter protophormiae")
+    rec = MR.build_host_evidence_record("Q7X2D3", prov, None)
+    return S.host_evidence_projection(rec)
+
+
+class TestGSchemaHostEvidencePositives(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.schema = S.gschema_host_evidence_schema()
+        cls.base = _live_dump()
+
+    def test_frozen_schema_identity_is_pinned(self):
+        self.assertEqual(S.sha256_file(self.schema["x-gschema-source"]),
+                         S.GS_SCHEMA_SHA256)
+        self.assertEqual(sorted(self.schema["properties"]),
+                         sorted(S.HOST_EVIDENCE_FIELDS))
+        self.assertFalse(self.schema["additionalProperties"])
+
+    def test_live_producer_output_validates(self):
+        jsonschema.validate(instance=self.base, schema=self.schema)
+
+    def test_unresolved_producer_output_validates_but_is_not_resolved(self):
+        prov = EV.EnzymeSourceProvenance(enzyme_uid="UNKNOWN1")
+        rec = MR.build_host_evidence_record("UNKNOWN1", prov)
+        dump = S.host_evidence_projection(rec)
+        jsonschema.validate(instance=dump, schema=self.schema)
+        self.assertEqual(dump["host_resolution"], "UNRESOLVED")
+        self.assertIsNone(dump["source_signature"])
+        self.assertEqual(dump["host_evidence_source"], ["UNRESOLVED"])
+
+    def test_field_set_is_exactly_the_nine_frozen_fields(self):
+        self.assertEqual(sorted(self.base), sorted(S.HOST_EVIDENCE_FIELDS))
+
+
+class TestGSchemaHostEvidenceNegatives(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.schema = S.gschema_host_evidence_schema()
+        cls.base = _live_dump()
+
+    def _reject(self, mutate, reason):
+        bad = dict(self.base)
+        mutate(bad)
+        with self.assertRaises(jsonschema.ValidationError, msg=reason):
+            jsonschema.validate(instance=bad, schema=self.schema)
+
+    def test_extra_resolution_route_key_is_rejected(self):
+        self._reject(lambda d: d.update(resolution_route="LIVE_UNIPROT_REVIEWED"),
+                     "hostEvidence must stay a nine-field object")
+
+    def test_missing_evidence_hash_is_rejected(self):
+        self._reject(lambda d: d.pop("evidence_hash"), "evidence_hash is required")
+
+    def test_lower_case_host_resolution_is_rejected(self):
+        self._reject(lambda d: d.update(host_resolution="species"),
+                     "host_resolution is a frozen enum")
+
+    def test_non_sha256_evidence_hash_is_rejected(self):
+        self._reject(lambda d: d.update(evidence_hash="deadbeef"),
+                     "evidence_hash must be 64 lowercase hex")
+
+    def test_string_taxid_is_rejected(self):
+        self._reject(lambda d: d.update(host_taxid="37930"), "host_taxid must be integer")
+
+    def test_empty_evidence_source_array_is_rejected(self):
+        self._reject(lambda d: d.update(host_evidence_source=[]),
+                     "host_evidence_source needs >= 1 item")
+
+    def test_duplicated_evidence_source_is_rejected(self):
+        self._reject(lambda d: d.update(
+            host_evidence_source=["UNIPROT_REVIEWED", "UNIPROT_REVIEWED"]),
+            "host_evidence_source items must be unique")
+
+    def test_empty_enzyme_uid_is_rejected(self):
+        self._reject(lambda d: d.update(enzyme_uid=""), "enzyme_uid must be non-empty")
+
+    def test_warnings_as_string_is_rejected(self):
+        self._reject(lambda d: d.update(warnings="not-an-array"),
+                     "warnings must be an array of strings")
+
+    def test_unresolved_source_mixed_with_reviewed_is_still_schema_valid_but_producer_rejects(self):
+        """schema 允许该组合，但 production producer 不得把 UNRESOLVED 与 reviewed 混发。"""
+        up = EV.UniProtReviewedHostEvidence(
+            source_url="https://rest.uniprot.org/uniprotkb/Q7X2D3.json",
+            response_sha256=SHA_OK, primary_accession="Q7X2D3",
+            entry_type="UniProtKB reviewed (Swiss-Prot)",
+            scientific_organism_name="Glutamicibacter protophormiae", ncbi_taxon_id=37930,
+            lineage=["Bacteria"], annotation_score=5.0,
+            protein_existence="1: evidence at protein level")
+        prov = EV.EnzymeSourceProvenance(
+            enzyme_uid="Q7X2D3", uniprot_reviewed=up,
+            resolution_route="LIVE_UNIPROT_REVIEWED",
+            host_identity_source="CONSTRUCTED_TAXON_ORGANISM",
+            host_identity_source_signature="taxon:37930|organism:glutamicibacter protophormiae",
+            host_resolution="SPECIES", host_taxid=37930,
+            host_name="Glutamicibacter protophormiae")
+        rec = MR.build_host_evidence_record("Q7X2D3", prov, None)
+        self.assertNotIn("UNRESOLVED", rec.host_evidence_source)
+        self.assertEqual(rec.host_resolution, "SPECIES")
+
+
+if __name__ == "__main__":
+    unittest.main(verbosity=2)
