+            self.assertEqual(params, ["state"], fn.__name__)
+            ann = inspect.signature(fn).parameters["state"].annotation
+            self.assertIs(ann, EnzymeCrewState, fn.__name__)
+
+    def test_state_and_graph_are_untouched_by_this_task(self):
+        """§3/§11 边界：src/graph.py、src/state.py、router/edge 必须与 base commit 一致。"""
+        git = shutil.which("git")
+        if git is None or not (ROOT / ".git").is_dir():
+            self.skipTest("teacher base git metadata unavailable")
+        proc = subprocess.run(
+            [git, "--no-pager", "diff", "--name-only", "HEAD"],
+            cwd=str(ROOT), capture_output=True, timeout=120, check=True)
+        changed = [ln.strip() for ln in proc.stdout.decode("utf-8").splitlines() if ln.strip()]
+        # 1) 禁止清单：图 / 状态 / router / edge 一个字节都不能变
+        self.assertEqual([p for p in changed
+                          if p in ("src/graph.py", "src/state.py")
+                          or "router" in p or "edge" in p], [], changed)
+        # 2) 改动面必须落在 §11 允许的 R2A 集合 + R1 已继承集合内
+        r2a_allowed = {
+            "src/schemas/evidence.py",
+            "src/tools/microbe_recommender.py",
+            "src/nodes/microbe_selection_node.py",
+            "src/utils/organism_aggregator.py",
+        }
+        r1_inherited = {
+            "src/nodes/reaction_prediction_node.py",
+            "src/tools/reaction_predictor.py",
+            "src/tools/reaction_retriever.py",
+            "config/settings.py",
+        }
+        unexpected = [p for p in changed if p not in r2a_allowed | r1_inherited
+                      and not p.startswith("tests/")]
+        self.assertEqual(unexpected, [], "changed source files outside the allowed scope")
+        self.assertIn("src/tools/microbe_recommender.py", changed)
+        # 3) 未跟踪的新文件只允许出现在 tests/ 下
+        untracked = subprocess.run(
+            [git, "ls-files", "--others", "--exclude-standard"],
+            cwd=str(ROOT), capture_output=True, timeout=120, check=True)
+        bad = [ln.strip() for ln in untracked.stdout.decode("utf-8").splitlines()
+               if ln.strip() and not ln.strip().startswith("tests/")]
+        self.assertEqual(bad, [])
