+# -*- coding: utf-8 -*-
+"""T6-R3A G3b: 8001 依赖清零测试（字面量拼接构造，避免正则自命中）。"""
+import re
+import sys
+import unittest
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+
+_P_LOCALHOST = "localhost" + ":800" + "1"
+_P_LOOPBACK = "127.0.0.1" + ":800" + "1"
+_P_ENVKEY = "ENZYME2ORGANISM" + "_API_URL"
+_PATTERN = re.compile("|".join([re.escape(_P_LOCALHOST), re.escape(_P_LOOPBACK), _P_ENVKEY]))
