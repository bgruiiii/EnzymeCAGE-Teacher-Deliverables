+    def test_same_taxon_different_host_identity_still_merges_by_taxid(self):
+        prov = {
+            "U1": _provenance("U1", 522306, "Accumulibacter regalis"),
+            "U2": _provenance("U2", 522306, "Accumulibacter regalis",
+                              signature="proteome:UP000022141",
+                              resolution="EXACT_STRAIN"),
+        }
+        out = OA.aggregate_organisms([_ranked("U1", 1), _ranked("U2", 2)], prov)
+        self.assertEqual(len(out), 1)
+        self.assertEqual(out[0].organism_uid, "522306")
+        self.assertEqual(out[0].supporting_enzyme_count, 2)
+        self.assertIsNone(out[0].host_identity_source_signature)
+        self.assertIn("signature=null", out[0].aggregation_notes)
+
+    def test_candidate_round_trips_through_state_serialisation(self):
+        prov = {"U1": _provenance("U1", 100, "Hostus primarius")}
+        out = OA.aggregate_organisms([_ranked("U1", 1)], prov)
