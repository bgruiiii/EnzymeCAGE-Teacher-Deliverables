+
+def sha256_file(path):
+    digest = hashlib.sha256()
+    with open(str(path), "rb") as fh:
+        for chunk in iter(lambda: fh.read(1 << 20), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def raw_dir():
+    override = (os.environ.get("R2A_UNIPROT_RAW_DIR") or "").strip()
+    candidates = [Path(override)] if override else []
+    candidates.extend(RAW_DIR_FALLBACKS)
+    for cand in candidates:
+        if (cand / (UIDS[0] + ".json")).exists():
+            return cand
+    return None
+
+
+def frozen_bytes_map():
+    """按任务书要求复用 R1 冻结 raw bytes（不重新联网），并核 SHA。"""
+    directory = raw_dir()
+    if directory is None:
+        return None
+    out = {}
+    for uid in UIDS:
+        body = (directory / (uid + ".json")).read_bytes()
+        digest = hashlib.sha256(body).hexdigest()
+        if digest != RAW_SHA256[uid]:
+            raise AssertionError(
+                "frozen UniProt raw bytes identity mismatch for %s: observed %s expected %s"
+                % (uid, digest, RAW_SHA256[uid])
+            )
+        out[uid] = body
+    return out
+
+
+def uid_map_path():
+    """返回冻结 reviewed UID map 的可用绝对路径（不可用时 None）。"""
+    configured = (os.environ.get("C8_UID_SOURCE_MAP_PATH") or "").strip()
+    candidates = [Path(configured)] if configured else [UID_MAP_PATH_FALLBACK]
+    for cand in candidates:
+        if cand.is_file() and not cand.is_symlink():
+            return cand
+    return None
+
+
+def gschema_host_evidence_schema():
+    """定位冻结 G-SCHEMA 并返回可直接校验的 hostEvidence schema（同时核实物 SHA）。
+
+    hostEvidence 内部以 ``#/$defs/xxx`` 引用同文档的公共 $defs，因此必须把整个
+    $defs 注入到传入的 schema 根上，否则 $ref 无法解析（不改冻结 schema 本体）。
+    """
+    override = (os.environ.get("R2A_GSCHEMA_DIR") or "").strip()
+    roots = [Path(override)] if override else [GS_WORKDIR]
+    schema = None
+    for root in roots:
+        if not root.is_dir():
+            continue
+        hits = sorted(root.rglob("THREE_MODULE_EVIDENCE_CHAIN_SCHEMA.json"))
+        if hits:
+            schema = hits[0]
+            break
+    if schema is None and GS_TARBALL.is_file():
+        tmp = Path(tempfile.mkdtemp(prefix="r2a_gschema_"))
+        with tarfile.open(str(GS_TARBALL), "r:gz") as tf:
+            tf.extractall(str(tmp))
+        hits = sorted(tmp.rglob("THREE_MODULE_EVIDENCE_CHAIN_SCHEMA.json"))
+        if hits:
+            schema = hits[0]
+    if schema is None:
+        raise AssertionError(
+            "frozen G-SCHEMA not locatable (set R2A_GSCHEMA_DIR or restore the canonical tarball)"
+        )
+    digest = sha256_file(schema)
+    if digest != GS_SCHEMA_SHA256:
+        raise AssertionError(
+            "frozen G-SCHEMA json identity mismatch: observed %s expected %s"
+            % (digest, GS_SCHEMA_SHA256)
+        )
+    doc = json.loads(schema.read_text(encoding="utf-8"))
+    host_def = doc["$defs"]["hostEvidence"]
+    effective = {"$schema": doc.get("$schema", "https://json-schema.org/draft/2020-12/schema")}
+    effective.update(host_def)
+    effective["$defs"] = doc["$defs"]
+    effective["x-gschema-source"] = str(schema)
+    return effective
+
+
+def validate_host_evidence(record_dump):
+    """用冻结 G-SCHEMA 校验 production host evidence 投影（jsonschema，官方库）。"""
+    import jsonschema
+    jsonschema.validate(instance=record_dump, schema=gschema_host_evidence_schema())
+    return True
+
+
+def host_evidence_projection(record):
+    """投影为冻结 hostEvidence 的九字段（resolution_route/host_identity_source 为 exclude 字段）。"""
+    dumped = json.loads(record.model_dump_json())
+    missing = [f for f in HOST_EVIDENCE_FIELDS if f not in dumped]
+    extra = [k for k in dumped if k not in HOST_EVIDENCE_FIELDS]
+    if missing or extra:
+        raise AssertionError(
+            "hostEvidence projection is not the frozen nine fields: missing=%s extra=%s"
+            % (missing, extra)
+        )
+    return {k: dumped[k] for k in HOST_EVIDENCE_FIELDS}
+
+
+def run_script(script, env_extra=None, env_pop=(), timeout=600):
+    """在 fresh 子进程里跑指定 worker（§7：进程级 cache 天然隔离，不引入清缓存后门）。"""
+    env = dict(os.environ)
+    env["PYTHONDONTWRITEBYTECODE"] = "1"
+    env["PYTHONPATH"] = str(ROOT)
+    for key, value in (env_extra or {}).items():
+        env[key] = value
+    for key in env_pop:
+        env.pop(key, None)
+    cmd = [sys.executable, "-B", str(ROOT / "tests" / script)]
+    proc = subprocess.run(cmd, cwd=str(ROOT), env=env, capture_output=True, timeout=timeout)
+    if proc.returncode != 0:
+        raise AssertionError(
+            "worker %s env=%s exited %d\nstdout:\n%s\nstderr:\n%s"
+            % (script, env_extra, proc.returncode,
+               proc.stdout.decode("utf-8", "replace")[-4000:],
+               proc.stderr.decode("utf-8", "replace")[-4000:])
+        )
+    return json.loads(proc.stdout.decode("utf-8"))
+
+
+def run_worker(mode, env_extra=None, env_pop=(), timeout=600):
+    """三路径 worker（_t6r3ar2a_path_worker.py）的 fresh 进程入口。"""
+    extra = dict(env_extra or {})
+    extra["R2A_WORKER_MODE"] = mode
+    return run_script("_t6r3ar2a_path_worker.py", extra, env_pop, timeout)
+
+
+def worker_python():
+    return sys.executable
