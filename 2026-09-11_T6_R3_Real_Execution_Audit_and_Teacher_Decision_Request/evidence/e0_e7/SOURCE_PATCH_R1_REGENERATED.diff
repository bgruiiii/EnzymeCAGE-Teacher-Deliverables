+            lambda url: raw[url.rsplit("/", 1)[1].split(".")[0]]
+        )
+        try:
+            for uid in FROZEN_HOSTS:
+                evidence, err = microbe_recommender.query_uniprot_reviewed(uid)
+                self.assertIsNone(err, f"uid={uid} unexpected exclusion: {err}")
+                self.assertIsNotNone(evidence)
+                # 真实 client 对冻结 bytes 算出的 SHA 与冻结收据一致
+                self.assertEqual(evidence.response_sha256, FROZEN_HOSTS[uid]["sha"])
+                self.assertEqual(evidence.ncbi_taxon_id, FROZEN_HOSTS[uid]["taxon"])
+                self.assertEqual(evidence.scientific_organism_name,
+                                 FROZEN_HOSTS[uid]["name"])
+                prov = microbe_recommender.EnzymeSourceProvenance(
+                    enzyme_uid=uid, uniprot_reviewed=evidence
+                )
+                rec = microbe_recommender.build_host_evidence_record(uid, prov, "SPECIES")
+                self.assertEqual(rec.host_evidence_source, ["UNIPROT_REVIEWED"])
+                self.assertEqual(rec.host_taxid, FROZEN_HOSTS[uid]["taxon"])
+        finally:
+            microbe_recommender._request_bytes = original
+
+
+if __name__ == "__main__":
+    unittest.main()
