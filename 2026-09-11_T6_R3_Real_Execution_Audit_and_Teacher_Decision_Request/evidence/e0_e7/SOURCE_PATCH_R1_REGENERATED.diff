+# -*- coding: utf-8 -*-
+"""T6-R3A-R2A §9：同宿主多酶合并正/负例 worker（fresh 进程 + 真实 production 节点）。
+
+契约测试专用冻结 fixture（任务书 §9 明确允许）：合成 enzyme UID + 合成 reviewed UniProt
+response bytes，只经真实 transport 注入点（``MR._request_bytes``）交给**真实**
+``microbe_selection_node``（含 map_enzyme_hosts → 宿主 identity 路由 → 冻结 G-SCHEMA 校验），
+禁止直接调用聚合 helper 作为最终结果。合成 response 带 r2aFixture 标记，不声称是真实
+UniProt 记录；本 worker 全程不访问公网。
+
+三个用例（R2A_MERGE_CASE）：
+  positive        两个不同 UID、不同 accession/evidence SHA，但同 TaxID + 同 host name
+                  → 必须合并成 1 个 aggregate、supporting enzymes=2、两份 evidence identity 都保留；
+  negative_name   同 TaxID、host name 不同（→ 宿主 identity signature 不同）
+                  → 冻结合同下不得合并；
+  negative_route  同 TaxID、一条走 live reviewed（构造签名 / SPECIES）、另一条走冻结 map
+                  fallback（proteome 审计签名 / EXACT_STRAIN）→ signature 与 resolution 都不同，
+                  同样不得合并（负例覆盖 §5 的两类 identity 来源）。
+"""
+import hashlib
+import json
+import logging
+import os
+import sys
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+for p in (str(ROOT), str(ROOT / "tests")):
+    if p not in sys.path:
+        sys.path.insert(0, p)
+
+import httpx  # noqa: E402
+
+import _t6r3ar2a_support as S  # noqa: E402
+from src.schemas import evidence as EV  # noqa: E402
+from src.state import EnzymeCrewState  # noqa: E402
+from src.tools import microbe_recommender as MR  # noqa: E402
+from src.nodes.microbe_selection_node import microbe_selection_node  # noqa: E402
+
+logging.basicConfig(level=logging.INFO, stream=sys.stderr)
+
+CASE = (os.environ.get("R2A_MERGE_CASE") or "positive").strip()
+
+# 合成宿主事实（仅契约测试；不对应任何真实 UniProt 记录）
+POS_TAXID = 990001
+POS_NAME = "Testus communis"
+NEG_TAXID = 990002
+NEG_NAME_A = "Testus communis"
+NEG_NAME_B = "Testus communis (strain R2A)"
+MIX_TAXID = 522306                       # 真实 A0A011QK89 的宿主 TaxID（负例共用）
+MIX_NAME = "Accumulibacter regalis"
+REAL_FALLBACK_UID = "A0A011QK89"         # 负例 B 里被强制 live 失败 → 走冻结 map fallback
+
+
+def _fixture_response(uid, taxid, name, annotation_score):
+    """构造一份能通过 production query_uniprot_reviewed 校验的合成 reviewed response。"""
+    payload = {
+        "primaryAccession": uid,
+        "uniProtkbId": uid + "_TESTUS",
+        "entryType": "UniProtKB reviewed (Swiss-Prot)",
+        "organism": {"scientificName": name, "taxonId": taxid,
+                     "lineage": ["Bacteria", "Contract fixture lineage"]},
+        "annotationScore": annotation_score,
+        "proteinExistence": "1: evidence at protein level",
+        "r2aFixture": "T6-R3A-R2A §9 contract-test fixture; not a real UniProt record",
+    }
+    return json.dumps(payload, ensure_ascii=False, sort_keys=True).encode("utf-8")
+
+
+CASES = {
+    "positive": {
+        "uids": ["R2AMERGEP1", "R2AMERGEP2"],
+        "hosts": [(POS_TAXID, POS_NAME), (POS_TAXID, POS_NAME)],
+        "scores": ["3.2", "4.1"],
+        "force_fail": [],
+    },
+    "negative_name": {
+        "uids": ["R2AMERGEN1", "R2AMERGEN2"],
+        "hosts": [(NEG_TAXID, NEG_NAME_A), (NEG_TAXID, NEG_NAME_B)],
+        "scores": ["3.5", "5.0"],
+        "force_fail": [],
+    },
+    "negative_route": {
+        "uids": ["R2AMERGEN3", REAL_FALLBACK_UID],
+        "hosts": [(MIX_TAXID, MIX_NAME)],
+        "scores": ["3.7"],
+        "force_fail": [REAL_FALLBACK_UID],
+    },
+}
+if CASE not in CASES:
+    raise SystemExit("unknown R2A_MERGE_CASE: " + repr(CASE))
+
+CONF = CASES[CASE]
+FIXTURE_RESPONSES = {}
+for uid, (taxid, name), score in zip(
+        [u for u in CONF["uids"] if u not in CONF["force_fail"]],
+        CONF["hosts"],
+        CONF["scores"]):
+    FIXTURE_RESPONSES[uid] = _fixture_response(uid, taxid, name, score)
+
+calls = {"fixture_uniprot": 0, "forced_uniprot_failure": 0, "kegg": 0, "other": 0}
+
+
+def _request_bytes(url):
+    for uid, body in FIXTURE_RESPONSES.items():
+        if url == MR._uniprot_url(uid):
+            calls["fixture_uniprot"] += 1
+            return body
+    if url in {MR._uniprot_url(u) for u in CONF["force_fail"]}:
+        calls["forced_uniprot_failure"] += 1
+        raise httpx.ConnectError("R2A §9 fixture: controlled simulated UniProt network failure")
+    if url.startswith("https://rest.kegg.jp/"):
+        calls["kegg"] += 1
+        return b""                       # KEGG 冻结空响应（独立补充，不参与宿主身份）
+    calls["other"] += 1
+    raise httpx.ConnectError("R2A §9 fixture: no response for " + url)
+
+
+MR._request_bytes = _request_bytes
+
+scan_calls = {"n": 0}
+_original_scan = MR._frozen_map_scan
+
+
+def _counting_scan(path):
+    scan_calls["n"] += 1
+    return _original_scan(path)
+
+
+MR._frozen_map_scan = _counting_scan
+
+
+def main():
+    ranked = [
+        EV.RankedEnzyme(uid=uid, score=round(0.9 - 0.01 * i, 4), rank=i + 1,
+                        ensemble_ci=(round(0.85 - 0.01 * i, 4), round(0.95 - 0.01 * i, 4)))
+        for i, uid in enumerate(CONF["uids"])
+    ]
+    state = EnzymeCrewState(user_query="T6-R3A-R2A §9 same-host merge case=" + CASE)
+    state = state.model_copy(update={"ranked_enzymes": ranked})
+
+    node_out = microbe_selection_node(state)          # ← 真实 production 节点
+    stats = MR.frozen_map_cache_stats()
+    microbe_candidates = node_out["microbe_candidates"]
+    organism_candidates = node_out["organism_candidates"]
+    evidence_chain = node_out["evidence_chain"]
+    ev_microbe = [e for e in evidence_chain if e.stage == "microbe"][-1]
+
+    before_scan = scan_calls["n"]
+    records = MR.host_evidence_records_from_node_output(
+        microbe_candidates=microbe_candidates,
+        organism_candidates=organism_candidates,
+        evidence_records=[e for e in evidence_chain if e.stage == "microbe"],
+    )
+    projections = []
+    for rec in records:
+        proj = S.host_evidence_projection(rec)
+        S.validate_host_evidence(proj)
+        projections.append(proj)
+
+    payload = {
+        "case": CASE,
+        "query_uids": list(CONF["uids"]),
+        "fixture_note": "synthetic contract-test fixture (task section 9); no public network access",
+        "fixture_response_sha256": {u: hashlib.sha256(b).hexdigest()
+                                    for u, b in FIXTURE_RESPONSES.items()},
+        "forced_live_failure_uids": list(CONF["force_fail"]),
+        "transport_calls": dict(calls),
+        "frozen_map_scan_delta_during_conversion": scan_calls["n"] - before_scan,
+        "cache_stats_after_node": {k: stats[k] for k in ("open_count", "scan_count",
+                                                         "line_read_count", "gate_error")},
+        "microbe_candidates": [
+            {"enzyme_uid": c.enzyme_uid, "organism_name": c.organism_name,
+             "tax_id": c.tax_id, "resolution_route": c.resolution_route,
+             "host_identity_source_signature": c.host_identity_source_signature}
+            for c in microbe_candidates
+        ],
+        "aggregates": [
+            {
+                "organism_uid": o.organism_uid,
+                "ncbi_taxon_id": o.ncbi_taxon_id,
+                "organism_name": o.organism_name,
+                "host_identity_source_signature": o.host_identity_source_signature,
+                "supporting_enzyme_count": o.supporting_enzyme_count,
+                "supporting_enzymes": [se.uid for se in o.supporting_enzymes],
+                "aggregation_notes": o.aggregation_notes,
+                "per_enzyme_identity": [
+                    {
+                        "enzyme_uid": p.enzyme_uid,
+                        "resolution_route": p.resolution_route,
+                        "host_identity_source": p.host_identity_source,
+                        "host_identity_source_signature": p.host_identity_source_signature,
+                        "host_resolution": p.host_resolution,
+                        "host_taxid": p.host_taxid,
+                        "host_name": p.host_name,
+                        "live_accession": p.uniprot_reviewed.primary_accession if p.uniprot_reviewed else None,
+                        "live_response_sha256": p.uniprot_reviewed.response_sha256 if p.uniprot_reviewed else None,
+                        "frozen_map_file": p.frozen_map_file,
+                        "frozen_map_line": p.frozen_map_line,
+                        "frozen_map_row_sha256": p.frozen_map_row_sha256,
+                    }
+                    for p in o.per_enzyme_source_provenance
+                ],
+            }
+            for o in organism_candidates
+        ],
+        "node_evidence_data": {
+            "status": ev_microbe.data.get("status"),
+            "host_resolution_routes": ev_microbe.data.get("host_resolution_routes"),
+            "aggregated_organisms": ev_microbe.data.get("aggregated_organisms"),
+            "output_candidates": ev_microbe.data.get("output_candidates"),
+            "unresolved_host_ledger": ev_microbe.data.get("unresolved_host_ledger"),
+        },
+        "uncertainty_flags": [f for f in node_out["uncertainty_flags"] if "microbe_selection" in f],
+        "host_evidence_gschema_validated": True,
+        "host_evidence_records": projections,
+    }
+    sys.stdout.write(json.dumps(payload, ensure_ascii=False, indent=1))
+
+
+if __name__ == "__main__":
+    main()
