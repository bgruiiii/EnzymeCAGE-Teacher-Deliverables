+# -*- coding: utf-8 -*-
+"""T6-R3A-R1 §10 R1新增: V11 microbe节点→direct REST client真实接线 + 冻结REST fixture.
+
+覆盖（teacher main 相关 + R1 新增要求）:
+- V11: microbe 节点 (src/nodes/microbe_selection_node.py) 到 direct REST client
+  (src/tools/microbe_recommender) 真实可达; microbe 链路无 8001;
+- REST fixture: 2026-09-09 冻结 raw bytes 注入 transport（不访问公网）:
+  reviewed 命中 / unreviewed entryType 拒绝 / KEGG ConnectError 诚实降级
+  SourceError（不伪造 KEGG 补充、不并入 host_evidence_source）;
+- map_enzyme_hosts 首见去重语义。
+
+fixture 目录可用环境变量 T6R3AR1_UNIPROT_RAW_DIR 覆盖; 缺失时 skipTest。
+"""
+import json
+import os
+import sys
+import unittest
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+sys.path.insert(0, str(ROOT))
+
+import httpx  # noqa: E402
+
+from src.tools import microbe_recommender as mr  # noqa: E402
+
+# ── 2026-09-09 冻结 4 UID 真实值（live GET 存证, SHA 与 R3A 首包冻结收据一致）──
+FROZEN_HOSTS = {
+    "Q7X2D3": {"taxon": 37930, "name": "Glutamicibacter protophormiae"},
+    "A0A075BSX9": {"taxon": 879274, "name": "Shinella sp. (strain HZN7)"},
+    "A0A017SP50": {"taxon": 1388766, "name": "Aspergillus ruber (strain CBS 135680)"},
+    "A0A011QK89": {"taxon": 522306, "name": "Accumulibacter regalis"},
+}
+UIDS = list(FROZEN_HOSTS)
+FROZEN_RAW_FALLBACK = Path(
+    "/usrdata/EnzymeCAGE_data/EnzymeCAGE-master/HPC_Returned_Result_Summaries/"
+    "enzymecage_three_module_t6_r3a_r1_uniprot_host_provenance_runtime_wiring_"
+    "delivery_correction_20260909/uniprot_raw"
+)
+
+
+def _frozen_raw_dir():
+    raw_dir = os.environ.get("T6R3AR1_UNIPROT_RAW_DIR", "")
+    candidates = [Path(raw_dir)] if raw_dir else []
+    candidates.append(FROZEN_RAW_FALLBACK)
+    for cand in candidates:
+        if (cand / "Q7X2D3.json").exists():
+            return cand
+    return None
+
+
+def _frozen_bytes_map():
+    raw_dir = _frozen_raw_dir()
+    if raw_dir is None:
+        return None
+    return {uid: (raw_dir / f"{uid}.json").read_bytes() for uid in UIDS}
+
+
+class TestV11MicrobeNodeDirectRestWiring(unittest.TestCase):
+    """teacher main microbe 节点到 direct REST client 真实可达, 无 8001。"""
+
+    def test_microbe_node_imports_direct_rest_client(self):
+        import src.nodes.microbe_selection_node as msn  # noqa: F401
+
+        src_text = (ROOT / "src" / "nodes" / "microbe_selection_node.py").read_text(
+            encoding="utf-8")
+        self.assertIn("from src.tools.microbe_recommender import", src_text)
+        self.assertIn("map_enzyme_hosts(top_uids)", src_text)
+        # direct REST client 入口真实可调用（不是死代码/孤立 helper）
+        self.assertTrue(callable(mr.map_enzyme_hosts))
+        self.assertTrue(callable(mr.query_uniprot_reviewed))
+        self.assertTrue(callable(mr.build_host_evidence_record))
+
+    def test_no_8001_in_microbe_chain_sources(self):
+        for rel in ("src/nodes/microbe_selection_node.py",
+                    "src/tools/microbe_recommender.py"):
+            text = (ROOT / rel).read_text(encoding="utf-8")
+            self.assertNotIn("8001", text, str(rel))
+        # direct REST: UniProt 公网 REST host, 无本地 8001 依赖
+        self.assertIn("rest.uniprot.org", mr._uniprot_url("Q7X2D3"))
+
+
+class TestRestFixtureFrozenTransport(unittest.TestCase):
+    """冻结 raw bytes 注入 transport: 真实 client 正负路径。"""
+
+    def test_reviewed_hit_through_real_client(self):
+        raw = _frozen_bytes_map()
+        if raw is None:
+            self.skipTest("frozen raw bytes dir not available; set T6R3AR1_UNIPROT_RAW_DIR")
+        original = mr._request_bytes
+        mr._request_bytes = lambda url: raw[url.rsplit("/", 1)[1].split(".")[0]]
+        try:
+            for uid in UIDS:
+                evidence, err = mr.query_uniprot_reviewed(uid)
+                self.assertIsNone(err, f"uid={uid} unexpected exclusion: {err}")
+                self.assertIsNotNone(evidence)
+                self.assertEqual(evidence.primary_accession, uid)
+                self.assertEqual(evidence.entry_type, "UniProtKB reviewed (Swiss-Prot)")
+                self.assertEqual(evidence.ncbi_taxon_id, FROZEN_HOSTS[uid]["taxon"])
+                self.assertEqual(evidence.scientific_organism_name,
+                                 FROZEN_HOSTS[uid]["name"])
+        finally:
+            mr._request_bytes = original
+
+    def test_unreviewed_entrytype_rejected_with_source_error(self):
+        raw = _frozen_bytes_map()
+        if raw is None:
+            self.skipTest("frozen raw bytes dir not available; set T6R3AR1_UNIPROT_RAW_DIR")
+        # MT-D1: unreviewed (TrEMBL) 必须被结构化排除, 不得混入 reviewed 宿主证据
+        doc = json.loads(raw["Q7X2D3"].decode("utf-8"))
+        doc["entryType"] = "UniProtKB unreviewed (TrEMBL)"
+        tampered = json.dumps(doc, ensure_ascii=False).encode("utf-8")
+        original = mr._request_bytes
+        mr._request_bytes = lambda url: tampered
+        try:
+            evidence, err = mr.query_uniprot_reviewed("Q7X2D3")
+        finally:
+            mr._request_bytes = original
+        self.assertIsNone(evidence)
+        self.assertIsNotNone(err)
+        self.assertEqual(err.source_database, "UniProtKB")
+        self.assertIn("reviewed", err.message)
+
+    def test_kegg_connect_error_honest_degradation_in_map(self):
+        raw = _frozen_bytes_map()
+        if raw is None:
+            self.skipTest("frozen raw bytes dir not available; set T6R3AR1_UNIPROT_RAW_DIR")
+        original = mr._request_bytes
+
+        def transport(url: str) -> bytes:
+            for uid in UIDS:
+                if url == mr._uniprot_url(uid):
+                    return raw[uid]
+            raise httpx.ConnectError(f"frozen transport: no fixture for {url}")
+
+        mr._request_bytes = transport
+        try:
+            prov = mr.map_enzyme_hosts(UIDS)
+        finally:
+            mr._request_bytes = original
+        self.assertEqual(set(prov), set(UIDS))
+        for uid in UIDS:
+            p = prov[uid]
+            # UniProt reviewed 命中; KEGG 诚实降级为 SourceError（不伪造补充证据）
+            self.assertIsNotNone(p.uniprot_reviewed, uid)
+            self.assertIsNone(p.kegg, uid)
+            kegg_errors = [e for e in p.source_errors if e.source_database == "KEGG"]
+            self.assertEqual(len(kegg_errors), 1, uid)
+            self.assertIn("ConnectError", kegg_errors[0].error_type)
+
+    def test_map_enzyme_hosts_first_seen_dedup(self):
+        raw = _frozen_bytes_map()
+        if raw is None:
+            self.skipTest("frozen raw bytes dir not available; set T6R3AR1_UNIPROT_RAW_DIR")
+        original = mr._request_bytes
+
+        def transport(url: str) -> bytes:
+            for uid in UIDS:
+                if url == mr._uniprot_url(uid):
+                    return raw[uid]
+            raise httpx.ConnectError(f"frozen transport: no fixture for {url}")
+
+        mr._request_bytes = transport
+        try:
+            prov = mr.map_enzyme_hosts(UIDS + ["Q7X2D3"])
+        finally:
+            mr._request_bytes = original
+        # 首见去重: 重复 UID 不产生第二个 provenance
+        self.assertEqual(list(prov), UIDS)
+
+
+if __name__ == "__main__":
+    unittest.main()
