+"""Lossless T2 conversion from PredictedReaction to CandidateReaction."""
+
+import hashlib
+from typing import List
+
+from src.schemas.evidence import CandidateReaction, PredictedReaction, SourceContribution
+
+
+def predicted_to_candidate(pred: PredictedReaction) -> CandidateReaction:
+    reaction_sha256 = hashlib.sha256(pred.reaction_smiles.encode("utf-8")).hexdigest()
+    contribution = SourceContribution(
+        source="predicted", source_tag=pred.source_tag, source_tool=pred.source_tool,
+        model_version=pred.model_version, provenance=pred.provenance,
+        source_record_id=pred.source_record_id, evidence_hash=pred.evidence_hash,
+        raw_score=pred.prediction_score.raw_score,
+        score_semantics=pred.prediction_score.score_semantics,
+    )
+    return CandidateReaction(
+        reaction_smiles=pred.reaction_smiles, reaction_sha256=reaction_sha256,
+        source="predicted", similarity_score=None,
+        prediction_rank=pred.prediction_rank, raw_score=pred.prediction_score.raw_score,
+        score_semantics=pred.prediction_score.score_semantics,
+        is_calibrated_probability=pred.prediction_score.is_calibrated_probability,
+        source_tag=pred.source_tag, source_tool=pred.source_tool,
+        model_version=pred.model_version, provenance=pred.provenance,
+        source_record_id=pred.source_record_id, evidence_hash=pred.evidence_hash,
+        depth=pred.depth, parent_node_smiles=pred.parent_node_smiles,
+        parent_node_depth=pred.parent_node_depth, warnings=list(pred.warnings),
+        source_contributions=[contribution],
+    )
+
+
+def merge_candidates(retrieved: List[CandidateReaction], predicted: List[CandidateReaction]) -> List[CandidateReaction]:
+    """Retrieved-first stable merge; duplicate reactions retain typed contributions."""
+    out: List[CandidateReaction] = []
+    positions: dict[str, int] = {}
+    ordered = list(retrieved) + sorted(predicted, key=lambda item: item.prediction_rank or 999)
+    for candidate in ordered:
+        contribution = candidate.source_contributions
+        if not contribution:
+            contribution = [SourceContribution(
+                source=candidate.source, source_tag=candidate.source_tag,
+                source_tool=candidate.source_tool, model_version=candidate.model_version,
+                provenance=candidate.provenance, source_record_id=candidate.source_record_id,
+                evidence_hash=candidate.evidence_hash, similarity_score=candidate.similarity_score,
+                raw_score=candidate.raw_score, score_semantics=candidate.score_semantics,
+            )]
+            candidate = candidate.model_copy(update={"source_contributions": contribution})
+        key = candidate.reaction_smiles
+        if key not in positions:
+            positions[key] = len(out)
+            out.append(candidate)
+        else:
+            index = positions[key]
+            out[index] = out[index].model_copy(update={
+                "source_contributions": out[index].source_contributions + contribution
+            })
+    return out
