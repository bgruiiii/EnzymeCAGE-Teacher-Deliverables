+import hashlib
+import os
+import tempfile
+import unittest
+
+from src.schemas.evidence import EnzymeSourceProvenance, RankedEnzyme, UniProtReviewedHostEvidence
+from src.tools import microbe_recommender as MR
+from src.utils.organism_aggregator import aggregate_organisms
+
+
+HEADER = list(MR.FROZEN_UID_MAP_REQUIRED_COLUMNS)
+
+
+def ranked(uid, rank):
+    return RankedEnzyme(uid=uid, score=1.0 / rank, rank=rank)
+
+
+def provenance(uid, taxid, name, signature, resolution="SPECIES", route="LIVE_UNIPROT_REVIEWED"):
+    live = None
+    if route == "LIVE_UNIPROT_REVIEWED":
+        live = UniProtReviewedHostEvidence(
+            primary_accession=uid, entry_type=MR.UNIPROT_ENTRY_TYPE,
+            scientific_organism_name=name, ncbi_taxon_id=taxid,
+            source_url="https://rest.uniprot.org/uniprotkb/%s.json" % uid,
+            response_sha256="a" * 64, lineage=["Bacteria"], annotation_score=4.0,
+            protein_existence="1: evidence at protein level")
+    return EnzymeSourceProvenance(
+        enzyme_uid=uid, uniprot_reviewed=live, resolution_route=route,
+        host_identity_source="FROZEN_REVIEWED_UID_MAP",
+        host_identity_source_signature=signature, host_resolution=resolution,
+        host_taxid=taxid, host_name=name,
+        frozen_map_file="uid_to_source_keep_bacteria_fungi_archaea.csv",
+        frozen_map_line=2, frozen_map_row_sha256="b" * 64,
+        frozen_map_table_sha256=MR.FROZEN_UID_MAP_SHA256)
+
+
+class TestTeacherTaxidAggregationM1ToM8(unittest.TestCase):
+    def test_m1_same_taxid_same_signature_distinct_record_identity(self):
+        p = {u: provenance(u, 100, "Host one", "taxon:100|organism:host one") for u in ("U1", "U2")}
+        p["U2"].frozen_map_line = 3
+        p["U2"].frozen_map_row_sha256 = "c" * 64
+        out = aggregate_organisms([ranked("U1", 1), ranked("U2", 2)], p)
+        self.assertEqual((len(out), out[0].supporting_enzyme_count), (1, 2))
+        self.assertEqual(len(out[0].per_enzyme_source_provenance), 2)
+
+    def test_m2_same_taxid_different_signature_name_merges_and_discloses(self):
+        p = {"U1": provenance("U1", 100, "Host one", "taxon:100|organism:host one"),
+             "U2": provenance("U2", 100, "Host one (old)", "taxon:100|organism:host one old")}
+        out = aggregate_organisms([ranked("U1", 1), ranked("U2", 2)], p)
+        self.assertEqual(len(out), 1); self.assertIsNone(out[0].host_identity_source_signature)
+        self.assertIn("U1(signature=", out[0].aggregation_notes); self.assertIn("U2(signature=", out[0].aggregation_notes)
+
+    def test_m3_same_taxid_live_map_resolution_difference_merges(self):
+        p = {"U1": provenance("U1", 100, "Host", "taxon:100|organism:host"),
+             "U2": provenance("U2", 100, "Host", "proteome:P100", "EXACT_STRAIN", "FROZEN_REVIEWED_UID_MAP_FALLBACK")}
+        out = aggregate_organisms([ranked("U1", 1), ranked("U2", 2)], p)
+        self.assertEqual(len(out), 1); self.assertEqual(out[0].supporting_enzyme_count, 2)
+        self.assertIn("resolution=", out[0].aggregation_notes)
+
+    def test_m4_different_taxid_same_signature_never_merges(self):
+        p = {"U1": provenance("U1", 100, "Host", "shared:host"),
+             "U2": provenance("U2", 200, "Host", "shared:host")}
+        self.assertEqual(len(aggregate_organisms([ranked("U1", 1), ranked("U2", 2)], p)), 2)
+
+    def test_m5_uid_unique_positive_taxid_string(self):
+        p = {"U1": provenance("U1", 100, "A", "taxon:100|organism:a"),
+             "U2": provenance("U2", 200, "B", "taxon:200|organism:b")}
+        out = aggregate_organisms([ranked("U1", 1), ranked("U2", 2)], p)
+        self.assertEqual([o.organism_uid for o in out], [str(o.ncbi_taxon_id) for o in out])
+        self.assertEqual(len({o.organism_uid for o in out}), len(out)); self.assertTrue(all(o.ncbi_taxon_id > 0 for o in out))
+
+    def test_m6_map_fallback_participates(self):
+        p = {"U1": provenance("U1", 100, "Host", "taxon:100|organism:host", route="FROZEN_REVIEWED_UID_MAP_FALLBACK")}
+        self.assertEqual(aggregate_organisms([ranked("U1", 1)], p)[0].organism_uid, "100")
+
+    def test_m7_unresolved_excluded(self):
+        p = {"U1": EnzymeSourceProvenance(enzyme_uid="U1", resolution_route=None)}
+        self.assertEqual(aggregate_organisms([ranked("U1", 1)], p), [])
+
+    def test_m8_count_desc_then_numeric_taxid(self):
+        p = {"U1": provenance("U1", 20, "A", "s20"), "U2": provenance("U2", 10, "B", "s10"),
+             "U3": provenance("U3", 30, "C", "s30"), "U4": provenance("U4", 30, "C", "s30")}
+        out = aggregate_organisms([ranked(u, i + 1) for i, u in enumerate(p)], p)
+        self.assertEqual([o.ncbi_taxon_id for o in out], [30, 10, 20])
+
+
+class TestRawCsvLineBytes(unittest.TestCase):
+    def setUp(self):
+        self.saved = (MR._FROZEN_MAP_INDEX, MR._FROZEN_MAP_HEADER, MR._FROZEN_MAP_FH)
+
+    def tearDown(self):
+        MR._FROZEN_MAP_INDEX, MR._FROZEN_MAP_HEADER, MR._FROZEN_MAP_FH = self.saved
+
+    def read(self, rows):
+        header = ",".join(HEADER).encode() + b"\n"
+        body = header + b"".join(rows)
+        f = tempfile.NamedTemporaryFile(delete=False)
+        try:
+            f.write(body); f.close()
+            offset = len(header); locations = []
+            for line_no, raw in enumerate(rows, start=2):
+                locations.append((line_no, offset, len(raw))); offset += len(raw)
+            MR._FROZEN_MAP_INDEX = {"U1": tuple(locations)}; MR._FROZEN_MAP_HEADER = HEADER; MR._FROZEN_MAP_FH = None
+            return MR._frozen_map_read_row(f.name, "U1")
+        finally:
+            os.unlink(f.name)
+
+    def valid(self, ending):
+        return b"U1,100,Host one,reviewed,taxon:100|organism:host one,taxon_organism,1,0,test" + ending
+
+    def test_lf_hash_includes_lf_and_fields_unchanged(self):
+        raw = self.valid(b"\n"); row, err = self.read([raw]); self.assertIsNone(err)
+        self.assertEqual(row["row_sha256"], hashlib.sha256(raw).hexdigest()); self.assertEqual(row["organism_name"], "Host one")
+
+    def test_crlf_hash_includes_crlf(self):
+        raw = self.valid(b"\r\n"); row, err = self.read([raw]); self.assertIsNone(err)
+        self.assertEqual(row["row_sha256"], hashlib.sha256(raw).hexdigest())
+
+    def test_final_line_without_terminator_hashes_actual_bytes(self):
+        raw = self.valid(b""); row, err = self.read([raw]); self.assertIsNone(err)
+        self.assertEqual(row["row_sha256"], hashlib.sha256(raw).hexdigest())
+
+    def test_duplicate_rows_keep_first_and_each_location_is_listed(self):
+        raw1, raw2 = self.valid(b"\n"), self.valid(b"\r\n")
+        row, err = self.read([raw1, raw2]); self.assertIsNone(err)
+        self.assertEqual(row["row_sha256"], hashlib.sha256(raw1).hexdigest()); self.assertEqual(row["duplicate_rows"], [3])
+
+    def test_conflicting_rows_fail_closed(self):
+        row2 = self.valid(b"\n").replace(b"Host one", b"Host two", 1)
+        row, err = self.read([self.valid(b"\n"), row2]); self.assertIsNone(row); self.assertIn("conflicting", err)
+
+
+if __name__ == "__main__":
+    unittest.main()
