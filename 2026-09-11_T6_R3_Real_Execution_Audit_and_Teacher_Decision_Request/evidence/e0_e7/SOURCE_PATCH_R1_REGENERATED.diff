+# -*- coding: utf-8 -*-
+"""T6-R3A-R2A §6：冻结 reviewed UID map lazy loader / 身份门 / 宿主 identity 防线测试。
+
+覆盖任务书 §6 八步纪律与 §5 的「宿主 identity ≠ enzyme UID」防线：
+1. lazy：首次真正需要 map 才开表；身份结论与错误都被进程级缓存（不重复核、不重复扫）；
+2. 开表前的身份门：路径未配置 / 缺失 / 非 regular / symlink / bytes / 固定 SHA / 文件名；
+3. CSV schema 现场确认（缺必要列即显式失败）；
+4. 行级：只接受 UID 精确匹配 + reviewed 合法行；ambiguous / 坏 TaxID / 空名 /
+   酶 UID 形签名 / 未知 resolution level / 多冲突行 → 显式错误（§6 禁静默、禁猜）；
+5. 同批后续 UID 使用缓存，整表至多一次扫描（含缺行负缓存）；
+6. 真实 104MB 冻结表：4 个本任务 UID 的已审计签名/行号/行 SHA/表 SHA 与 §5 一致；
+7. §5 确定性构造规则与不可冒充；模型级拒绝 UID 形宿主签名。
+所有 map 相关用例在 fresh 子进程执行（§7 纪律：不引入 test-only 清缓存后门）。
+"""
+import json
+import os
+import sys
+import unittest
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+for p in (str(ROOT), str(ROOT / "tests")):
+    if p not in sys.path:
+        sys.path.insert(0, p)
+
+import _t6r3ar2a_support as S  # noqa: E402
+from pydantic import ValidationError  # noqa: E402
+from src.schemas import evidence as EV  # noqa: E402
+from src.tools import microbe_recommender as MR  # noqa: E402
+
+
+def run_loader_case(case, env_extra=None, timeout=600):
+    import subprocess
+    env = dict(os.environ)
+    env.pop("C8_UID_SOURCE_MAP_PATH", None)   # 各用例自行设定 map 环境
+    env["PYTHONDONTWRITEBYTECODE"] = "1"
+    env["R2A_LOADER_CASE"] = case
+    env.update(env_extra or {})
+    proc = subprocess.run(
+        [sys.executable, "-B", str(ROOT / "tests" / "_t6r3ar2a_loader_worker.py")],
+        cwd=str(ROOT), env=env, capture_output=True, timeout=timeout,
+    )
+    if proc.returncode != 0:
+        raise AssertionError(
+            "loader case %s exited %d\nstdout:%s\nstderr:%s"
+            % (case, proc.returncode, proc.stdout.decode("utf-8", "replace")[-3000:],
+               proc.stderr.decode("utf-8", "replace")[-3000:])
+        )
+    payload = json.loads(proc.stdout.decode("utf-8"))
+    return payload["result"]
+
+
+class TestFrozenMapDeploymentConvention(unittest.TestCase):
+    """§6：复用既有 C8_UID_SOURCE_MAP_PATH 约定，不新造第二张表、不硬编码主机路径。"""
+
+    def test_env_var_is_the_existing_c8_convention(self):
+        self.assertEqual(MR.FROZEN_UID_MAP_ENV_VAR, "C8_UID_SOURCE_MAP_PATH")
+
+    def test_no_hardcoded_host_absolute_path_in_source(self):
+        text = (ROOT / "src" / "tools" / "microbe_recommender.py").read_text(encoding="utf-8")
+        for forbidden in ("/usrdata/", "/root/", "HPC_Returned_Result_Summaries"):
+            self.assertNotIn(forbidden, text, "source must not hardcode host path " + forbidden)
+
+    def test_frozen_identity_constants_match_task_authority(self):
+        self.assertEqual(MR.FROZEN_UID_MAP_BYTES, S.UID_MAP_BYTES)
+        self.assertEqual(MR.FROZEN_UID_MAP_SHA256, S.UID_MAP_SHA256)
+        self.assertEqual(MR.FROZEN_UID_MAP_BASENAME, S.UID_MAP_BASENAME)
+
+    def test_no_second_uid_map_file_created(self):
+        # 交付/仓库内不得出现被复制的 104MB 大表（§3/§13）
+        hits = [p for p in ROOT.rglob(S.UID_MAP_BASENAME)]
+        self.assertEqual(hits, [], "frozen UID map must not be copied into the repo: %s" % hits)
+
+
+class TestFrozenMapGate(unittest.TestCase):
+    """身份门（未配置 / 缺失 / symlink / bytes / SHA / 文件名 / schema）。"""
+
+    def test_unset_env_fails_closed_without_opening(self):
+        res = run_loader_case("gate_unset")
+        self.assertIn("is not configured", res["gate_error"])
+        self.assertEqual(res["rows"], {})
+        self.assertEqual(res["errors"], {})   # 整表不可用 → 全局错误，不逐 UID 伪造理由
+        self.assertEqual(res["second_gate_error"], res["gate_error"])
+        self.assertEqual(res["stats"]["open_count"], 0)
+        self.assertEqual(res["stats"]["scan_count"], 0)
+
+    def test_missing_table_fails_closed(self):
+        res = run_loader_case("gate_missing")
+        self.assertIn("missing/unreadable", res["gate_error"])
+        self.assertEqual(res["stats"]["open_count"], 0)
+
+    def test_symlink_is_refused(self):
+        res = run_loader_case("gate_symlink")
+        self.assertIn("symlink", res["gate_error"])
+        self.assertEqual(res["rows"], {})
+
+    def test_size_gate(self):
+        res = run_loader_case("gate_size")
+        self.assertIn("byte size mismatch", res["gate_error"])
+
+    def test_sha_gate(self):
+        res = run_loader_case("gate_sha")
+        self.assertIn("sha256 mismatch", res["gate_error"])
+        self.assertEqual(res["frozen_sha"], S.UID_MAP_SHA256)
+        self.assertIsNone(res["stats"]["table_sha256"])
+
+    def test_wrong_basename_is_refused(self):
+        res = run_loader_case("gate_basename")
+        self.assertIn("filename identity mismatch", res["gate_error"])
+
+    def test_csv_schema_confirmed_on_site(self):
+        res = run_loader_case("gate_schema")
+        self.assertIn("CSV schema mismatch", res["gate_error"])
+        self.assertIn("source_signature", res["gate_error"])
+
+
+class TestFrozenMapRowRules(unittest.TestCase):
+    """§6 行级：只接受 reviewed 合法行；身份不明/冲突一律显式错误，一次扫描覆盖同批。"""
+
+    @classmethod
+    def setUpClass(cls):
+        if S.uid_map_path() is None and not os.environ.get("R2A_ALLOW_MAP_SKIP"):
+            raise unittest.SkipTest("frozen UID map not locatable")
+        cls.res = run_loader_case("scan_rows")
+
+    def test_valid_rows_resolve_expected_identity(self):
+        rows = self.res["rows"]
+        self.assertEqual(rows["U1"]["host_resolution"], "EXACT_STRAIN")
+        self.assertEqual(rows["U1"]["resolution_level"], "proteome")
+        self.assertEqual(rows["U1"]["taxid"], 100)
+        self.assertEqual(rows["U1"]["organism_name"], "Testus organismus")
+        self.assertEqual(rows["U1"]["source_signature"], "taxon:100|organism:testus organismus")
+        self.assertEqual(rows["U1"]["mapping_confidence"], "high")
+        self.assertEqual(rows["U2"]["host_resolution"], "SPECIES")
+        self.assertEqual(rows["U2"]["resolution_level"], "taxon_organism")
+        # 原始行 identity：1-based 物理行号 + 原始行 bytes 的 SHA256 + 表 SHA
+        self.assertEqual(rows["U1"]["line"], 2)
+        self.assertEqual(rows["U2"]["line"], 3)
+        self.assertEqual(len(rows["U1"]["row_sha256"]), 64)
+        self.assertEqual(rows["U1"]["table_sha256"], self.res["expected_table_sha"])
+        self.assertEqual(rows["U1"]["file"], MR.FROZEN_UID_MAP_BASENAME)
+
+    def test_illegal_rows_are_explicit_errors(self):
+        errors = dict(self.res["first_errors"])
+        errors.update(self.res["second_errors"])
+        self.assertIn("not a reviewed row", errors["U3"])
+        self.assertIn("flagged ambiguous", errors["U4"])
+        self.assertIn("enzyme-UID-shaped", errors["U5"])
+        self.assertIn("unknown source_resolution_level", errors["U6"])
+        self.assertIn("non-positive TaxID", errors["U7"])
+        self.assertIn("conflicting host identity rows", errors["D1"])
+        self.assertIn("no row in the frozen reviewed UID map", errors["NOT_IN_TABLE"])
+        for uid in ("U3", "U4", "U5", "U6", "U7", "D1", "NOT_IN_TABLE"):
+            self.assertNotIn(uid, self.res["rows"])
+        # 缺行/坏行结论也被永久缓存（第三次查询给同样的显式理由）
+        self.assertIn("NOT_IN_TABLE", self.res["third_errors"])
+        self.assertEqual(self.res["third_errors"]["NOT_IN_TABLE"],
+                         errors["NOT_IN_TABLE"])
+        self.assertEqual(self.res["third_rows"], ["U1", "U2"])
+
+    def test_identical_duplicate_rows_keep_one_and_note(self):
+        self.assertIn("E1", self.res["rows"])
+        self.assertEqual(self.res["rows"]["E1"]["duplicate_rows"], [12])
+        self.assertEqual(self.res["rows"]["E1"]["line"], 11)
+
+    def test_single_scan_for_whole_process(self):
+        mid, after, repeat = self.res["stats_mid"], self.res["stats"], self.res["stats_after_repeat"]
+        self.assertEqual(mid["scan_count"], 1)
+        self.assertEqual(after["scan_count"], 1, "same process must not re-scan the table")
+        self.assertEqual(after["open_count"], 1)
+        self.assertTrue(after["full_scan_done"])
+        self.assertEqual(after["cached_queried_uids"], 10)
+        # 扫描只建定位索引（9 个 UID 键），行内容靠 os.pread 回读（11 次定位读 = 含重复行）
+        self.assertEqual(after["indexed_uids"], 9)
+        self.assertEqual(mid["line_read_count"], 4)
+        self.assertEqual(after["line_read_count"], 11)
+        # 第三批全是已查过的 UID ⇒ 零新增扫描与零新增行回读
+        self.assertEqual(repeat["scan_count"], 1)
+        self.assertEqual(repeat["open_count"], 1)
+        self.assertEqual(repeat["line_read_count"], 11)
+        self.assertEqual(repeat["cached_row_uids"], after["cached_row_uids"])
+
+
+@unittest.skipIf(S.uid_map_path() is None and not os.environ.get("R2A_ALLOW_MAP_SKIP"),
+                 "frozen UID map not locatable")
+class TestRealFrozenMapIdentity(unittest.TestCase):
+    """真实冻结表：§5 四 UID 的已审计宿主签名 + 行 SHA 独立复算一致。"""
+
+    @classmethod
+    def setUpClass(cls):
+        cls.res = run_loader_case("real_table")
+        if cls.res.get("skipped"):
+            raise unittest.SkipTest(cls.res["skipped"])
+
+    def test_frozen_table_identity(self):
+        self.assertIsNone(self.res["gate_error"])
+        self.assertEqual(self.res["basename"], S.UID_MAP_BASENAME)
+        self.assertEqual(self.res["stats"]["table_sha256"], S.UID_MAP_SHA256)
+
+    def test_four_uids_match_task_section_5(self):
+        for uid in S.UIDS:
+            row = self.res["rows"][uid]
+            expected = S.MAP_HOST_IDENTITY[uid]
+            self.assertEqual(row["source_signature"], expected["source_signature"], uid)
+            self.assertEqual(row["taxid"], expected["taxid"], uid)
+            self.assertEqual(row["host_resolution"], expected["host_resolution"], uid)
+            self.assertEqual(row["line"], expected["line"], uid)
+            self.assertEqual(row["reviewed"], "reviewed", uid)
+            # 行 SHA 由 loader 计算，与在 loader 之外独立复算的原始行摘要一致
+            self.assertEqual(row["row_sha256"],
+                             self.res["row_sha_recomputed_outside_loader"][uid], uid)
+
+    def test_absent_uid_is_explicit_and_no_extra_scan(self):
+        self.assertIn("R2ASYNTH00ABSENT", self.res["second_errors"])
+        self.assertNotIn("R2ASYNTH00ABSENT", self.res["rows"])
+        self.assertEqual(self.res["stats_mid"]["scan_count"], 1)
+        self.assertEqual(self.res["stats"]["scan_count"], 1,
+                         "negative cache: absent uid must not trigger a second scan")
+        self.assertEqual(self.res["stats"]["open_count"], 1)
+        # 104MB 表只扫一次；4 个在表 UID + 1 个缺行 UID 共只回读 4 行
+        self.assertGreater(self.res["stats"]["indexed_uids"], 160000)
+        self.assertEqual(self.res["stats_mid"]["line_read_count"], 2)
+        self.assertEqual(self.res["stats"]["line_read_count"], 4)
+        self.assertEqual(self.res["stats_after_repeat"]["line_read_count"], 4)
+        self.assertEqual(self.res["stats_after_repeat"]["scan_count"], 1)
+
+
+class TestHostIdentitySignatureRules(unittest.TestCase):
+    """§5：host identity 签名 vs evidence record identity；模型层拒绝 UID 冒充宿主。"""
+
+    def test_construction_rule_documented_and_deterministic(self):
+        self.assertIn("casefold", MR.HOST_SIGNATURE_CONSTRUCTION_RULE)
+        self.assertIn("taxon:<positive_ncbi_taxid>", MR.HOST_SIGNATURE_CONSTRUCTION_RULE)
+        first = MR._constructed_host_signature(37930, "Glutamicibacter   protophormiae")
+        self.assertEqual(first, "taxon:37930|organism:glutamicibacter protophormiae")
+        self.assertEqual(first, MR._constructed_host_signature(37930, "  GLUTAMICIBACTER protophormiae "))
+        self.assertNotEqual(first, "uniprotkb_reviewed:Q7X2D3")
+        self.assertNotIn("Q7X2D3", first)
+
+    def test_uid_shaped_detector(self):
+        self.assertTrue(EV.host_signature_is_enzyme_uid_shaped("Q7X2D3", "Q7X2D3"))
+        self.assertTrue(EV.host_signature_is_enzyme_uid_shaped(
+            "Q7X2D3", "uniprotkb_reviewed:Q7X2D3"))
+        self.assertFalse(EV.host_signature_is_enzyme_uid_shaped(
+            "Q7X2D3", "taxon:37930|organism:glutamicibacter protophormiae"))
+        self.assertFalse(EV.host_signature_is_enzyme_uid_shaped("Q7X2D3", "proteome:UP000019804"))
+        self.assertFalse(EV.host_signature_is_enzyme_uid_shaped("Q7X2D3", None))
+
+    def test_host_evidence_record_rejects_enzyme_uid_signature(self):
+        base = dict(
+            enzyme_uid="Q7X2D3", host_taxid=37930, host_name="Glutamicibacter protophormiae",
+            host_resolution="SPECIES", host_evidence_source=["UNIPROT_REVIEWED"],
+            source_record_id="Q7X2D3", evidence_hash=S.RAW_SHA256["Q7X2D3"],
+        )
+        for forged in ("Q7X2D3", "uniprotkb_reviewed:Q7X2D3", " route:Q7X2D3"):
+            with self.assertRaises(ValidationError, msg=forged):
+                EV.HostEvidenceRecord(source_signature=forged, **base)
+        ok = EV.HostEvidenceRecord(
+            source_signature="taxon:37930|organism:glutamicibacter protophormiae", **base)
+        self.assertEqual(ok.source_signature,
+                         "taxon:37930|organism:glutamicibacter protophormiae")
+        self.assertEqual(ok.source_record_id, "Q7X2D3")   # accession 留在 record identity
+
+    def test_provenance_rejects_enzyme_uid_signature(self):
+        with self.assertRaises(ValidationError):
+            EV.EnzymeSourceProvenance(
+                enzyme_uid="Q7X2D3", resolution_route="LIVE_UNIPROT_REVIEWED",
+                host_identity_source="CONSTRUCTED_TAXON_ORGANISM",
+                host_identity_source_signature="uniprotkb_reviewed:Q7X2D3",
+                uniprot_reviewed=S_reviewed_evidence("Q7X2D3"),
+            )
+
+    def test_route_contract_forbids_live_forgery_in_fallback(self):
+        with self.assertRaises(ValidationError):
+            EV.EnzymeSourceProvenance(
+                enzyme_uid="Q7X2D3", resolution_route="FROZEN_REVIEWED_UID_MAP_FALLBACK",
+                host_identity_source="FROZEN_REVIEWED_UID_MAP",
+                host_identity_source_signature="taxon:37930|organism:x",
+                host_resolution="SPECIES", host_taxid=37930, host_name="X",
+                frozen_map_file="t.csv", frozen_map_line=1,
+                frozen_map_row_sha256="0" * 64, frozen_map_table_sha256="1" * 64,
+                uniprot_reviewed=S_reviewed_evidence("Q7X2D3"),   # 禁止：fallback 不得带 live 证据
+            )
+        with self.assertRaises(ValidationError):
+            EV.EnzymeSourceProvenance(     # fallback 缺行 identity → 拒绝
+                enzyme_uid="Q7X2D3", resolution_route="FROZEN_REVIEWED_UID_MAP_FALLBACK",
+                host_identity_source="FROZEN_REVIEWED_UID_MAP",
+                host_identity_source_signature="taxon:37930|organism:x",
+                host_resolution="SPECIES", host_taxid=37930, host_name="X",
+            )
+
+    def test_build_record_refuses_uid_shaped_carried_signature(self):
+        prov = EV.EnzymeSourceProvenance(
+            enzyme_uid="Q7X2D3", uniprot_reviewed=S_reviewed_evidence("Q7X2D3"))
+        # model_copy 不过 after-validator：用于注入 R2A 之前的旧缺陷形态，producer 必须拒绝
+        prov = prov.model_copy(update={
+            "resolution_route": "LIVE_UNIPROT_REVIEWED",
+            "host_identity_source": "CONSTRUCTED_TAXON_ORGANISM",
+            "host_identity_source_signature": "uniprotkb_reviewed:Q7X2D3",
+        })
+        with self.assertRaises(ValueError):
+            MR.build_host_evidence_record("Q7X2D3", prov, "SPECIES")
+
+    def test_enums_are_literal_tuples_and_route_is_not_host_resolution(self):
+        self.assertEqual(EV.HOST_RESOLUTION_LITERALS,
+                         ("EXACT_STRAIN", "SPECIES", "REPRESENTATIVE_STRAIN", "UNRESOLVED"))
+        self.assertEqual(EV.HOST_RESOLUTION_ROUTE_LITERALS,
+                         ("LIVE_UNIPROT_REVIEWED", "FROZEN_REVIEWED_UID_MAP_FALLBACK"))
+        self.assertEqual(EV.HOST_IDENTITY_SOURCE_LITERALS,
+                         ("FROZEN_REVIEWED_UID_MAP", "CONSTRUCTED_TAXON_ORGANISM"))
+        with self.assertRaises(ValueError):
+            EV.validate_host_resolution_route("UNRESOLVED")   # 两套枚举不得混用
+        self.assertEqual(EV.validate_host_resolution("SPECIES"), "SPECIES")
+
+
+def S_reviewed_evidence(uid: str):
+    """构造 live reviewed 证据对象（本任务四 UID 的冻结 raw 事实，不触网）。"""
+    import json
+    taxid, name = S.LIVE_HOSTS[uid]
+    return EV.UniProtReviewedHostEvidence(
+        source_url="https://rest.uniprot.org/uniprotkb/%s.json" % uid,
+        response_sha256=S.RAW_SHA256[uid], primary_accession=uid,
+        entry_type="UniProtKB reviewed (Swiss-Prot)", reviewed=True,
+        scientific_organism_name=name, ncbi_taxon_id=taxid, lineage=[],
+        annotation_score=5.0, protein_existence="1: Evidence at protein level",
+    )
+
+
+if __name__ == "__main__":
+    unittest.main()
