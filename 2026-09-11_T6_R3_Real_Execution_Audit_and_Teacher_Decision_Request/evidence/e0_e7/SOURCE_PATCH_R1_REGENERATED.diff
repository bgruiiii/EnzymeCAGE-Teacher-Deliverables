+# -*- coding: utf-8 -*-
+"""T6-R3A-R2A §9：同宿主多酶必须合并（正例）+ 同 TaxID 不同宿主 identity 不得合并（负例）。
+
+三例均走真实 production `microbe_selection_node`（fresh 子进程），下游 evidence 只由节点
+输出转换；正例使用**合成契约 fixture**（两个不同 UID / 不同 accession / 不同 evidence SHA
+但同一宿主 identity），任务书 §9 末条明确禁止用本来就属于不同宿主的
+A0A017SP50 / A0A011QK89 来证明合并正确。
+"""
+import os
+import sys
+import unittest
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+for p in (str(ROOT), str(ROOT / "tests")):
+    if p not in sys.path:
+        sys.path.insert(0, p)
+
+import _t6r3ar2a_support as S  # noqa: E402
+from src.schemas import evidence as EV  # noqa: E402
+
+
+def run_merge_case(case, env_extra=None, timeout=600):
+    extra = {"R2A_MERGE_CASE": case}
+    extra.update(env_extra or {})
+    return S.run_script("_t6r3ar2a_merge_worker.py", extra, timeout=timeout)
+
+
+def _sig_of(res, uid):
+    for rec in res["host_evidence_records"]:
+        if rec["enzyme_uid"] == uid:
+            return rec["source_signature"]
+    raise AssertionError("no host evidence record for uid " + uid)
+
+
+def _rec(res, uid):
+    for rec in res["host_evidence_records"]:
+        if rec["enzyme_uid"] == uid:
+            return rec
+    raise AssertionError("no host evidence record for uid " + uid)
+
+
+class TestSameHostTwoEnzymeMergePositive(unittest.TestCase):
+    """正例：同宿主（同 TaxID/name/signature）的两个酶 → 1 个 aggregate、2 个支持酶。"""
+
+    @classmethod
+    def setUpClass(cls):
+        cls.res = run_merge_case("positive")
+
+    def test_fixture_is_contract_only(self):
+        self.assertEqual(self.res["transport_calls"]["other"], 0)
+        self.assertEqual(self.res["transport_calls"]["kegg"], 2)
+        self.assertIn("contract-test fixture", self.res["fixture_note"])
+        # 禁用本来属于不同宿主的两个真实 UID 作为合并正例（§9 末条）
+        for forbidden in ("A0A017SP50", "A0A011QK89"):
+            self.assertNotIn(forbidden, self.res["query_uids"])
+
+    def test_two_uids_have_distinct_evidence_record_identity(self):
+        uids = self.res["query_uids"]
+        first, second = (_rec(self.res, u) for u in uids)
+        self.assertNotEqual(first["source_record_id"], second["source_record_id"])
+        self.assertNotEqual(first["evidence_hash"], second["evidence_hash"])
+        for rec in (first, second):
+            self.assertEqual(len(rec["evidence_hash"]), 64)
+            self.assertEqual(rec["host_evidence_source"], ["UNIPROT_REVIEWED"])
+            self.assertEqual(rec["host_resolution"], "SPECIES")
+        # evidence record identity（accession）与宿主 identity（signature）分离：§5
+        self.assertNotEqual(first["source_record_id"], first["source_signature"])
+
+    def test_merged_into_single_aggregate(self):
+        aggs = self.res["aggregates"]
+        self.assertEqual(len(aggs), 1, "same host identity must merge into one aggregate")
+        agg = aggs[0]
+        self.assertEqual(agg["supporting_enzyme_count"], 2)
+        self.assertEqual(sorted(agg["supporting_enzymes"]), sorted(self.res["query_uids"]))
+        self.assertEqual(agg["ncbi_taxon_id"], 990001)
+        self.assertEqual(agg["organism_uid"], "990001")
+        self.assertEqual(
+            agg["host_identity_source_signature"],
+            "taxon:990001|organism:testus communis",
+        )
+        self.assertEqual(len(agg["per_enzyme_identity"]), 2)
+        for item in agg["per_enzyme_identity"]:
+            self.assertEqual(item["resolution_route"], "LIVE_UNIPROT_REVIEWED")
+            self.assertEqual(item["host_identity_source"], "CONSTRUCTED_TAXON_ORGANISM")
+            self.assertEqual(item["host_identity_source_signature"],
+                             agg["host_identity_source_signature"])
+            self.assertIsNotNone(item["live_response_sha256"])
+        shas = {i["live_response_sha256"] for i in agg["per_enzyme_identity"]}
+        self.assertEqual(len(shas), 2, "two enzymes must keep two distinct evidence SHAs")
+
+    def test_both_evidence_records_share_one_host_signature(self):
+        uids = self.res["query_uids"]
+        self.assertEqual(_sig_of(self.res, uids[0]), _sig_of(self.res, uids[1]))
+        for uid in uids:
+            self.assertFalse(EV.host_signature_is_enzyme_uid_shaped(uid, _sig_of(self.res, uid)))
+
+    def test_conversion_does_not_requery(self):
+        self.assertEqual(self.res["frozen_map_scan_delta_during_conversion"], 0)
+        self.assertEqual(self.res["node_evidence_data"]["aggregated_organisms"], 1)
+        self.assertEqual(self.res["uncertainty_flags"], [])
+
+
+class TestSameTaxonDifferentSignatureMergedByTeacherKey(unittest.TestCase):
