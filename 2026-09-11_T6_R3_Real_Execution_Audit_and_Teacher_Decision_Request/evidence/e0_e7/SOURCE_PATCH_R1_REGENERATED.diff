+            enzyme_uid=prov.enzyme_uid, evidence_level="reviewed", source_db="UniProt",
+            resolution_route="LIVE_UNIPROT_REVIEWED",
+            host_identity_source_signature=prov.host_identity_source_signature,
+        )
+        records = MR.host_evidence_records_from_node_output([cand], [org], None)
+        bare = _live_provenance(with_identity=False)
+        supplemented = MR.build_host_evidence_record(bare.enzyme_uid, bare, "SPECIES")
+        after = MR.frozen_map_cache_stats()
+        for key in ("open_count", "scan_count", "line_read_count", "cached_queried_uids",
+                    "cached_row_uids"):
+            self.assertEqual(after[key], before[key],
+                             "conversion changed loader state on %s" % key)
+        rec = records[0]
+        self.assertEqual(rec.source_signature, "taxon:990001|organism:testus communis")
+        S.validate_host_evidence(S.host_evidence_projection(rec))
+        S.validate_host_evidence(S.host_evidence_projection(supplemented))
+
+    def test_conversion_supplements_missing_signature_from_carried_fields(self):
+        """§8 末段：state 只带原始 provenance 时，签名按 §5 从已携带字段补齐并记录来源。"""
+        prov = _live_provenance(with_identity=False)
+        rec = MR.build_host_evidence_record(prov.enzyme_uid, prov, "SPECIES")
+        self.assertEqual(rec.source_signature, "taxon:990001|organism:testus communis")
+        self.assertEqual(rec.host_identity_source, "CONSTRUCTED_TAXON_ORGANISM")
+        self.assertEqual(rec.host_resolution, "SPECIES")
+        self.assertEqual(rec.resolution_route, "LIVE_UNIPROT_REVIEWED")
+        self.assertEqual(rec.source_record_id, "R2ACARRY01")
+        warnings = " ".join(rec.warnings)
+        for token in ("host_identity_supplemented_at_conversion=CONSTRUCTED_TAXON_ORGANISM",
+                      "input_fields=ncbi_taxon_id=990001",
+                      "scientific_organism_name='Testus Communis'",
+                      "construction_rule=",
+                      "the conversion layer deliberately does not re-open the map",
+                      "no field was hand-filled by a task script"):
+            self.assertIn(token, warnings)
+
+    def test_bare_provenance_without_carried_resolution_raises_instead_of_guessing(self):
+        """R1 合同保留：live reviewed 证据但未携带 host resolution → 显式报错，不猜。"""
+        prov = _live_provenance(with_identity=False)
+        up = prov.uniprot_reviewed
+        org = _organism([prov])
+        cand = EV.MicrobeCandidate(
+            organism_name=up.scientific_organism_name, tax_id=up.ncbi_taxon_id,
+            enzyme_uid=prov.enzyme_uid, evidence_level="reviewed", source_db="UniProt",
+            resolution_route="LIVE_UNIPROT_REVIEWED",
+        )
+        with self.assertRaises(ValueError) as ctx:
+            MR.host_evidence_records_from_node_output([cand], [org], None)
+        self.assertIn("must not be downgraded to UNRESOLVED", str(ctx.exception))
+
+    def test_unresolved_ledger_is_converted_without_network(self):
+        ledger_entry = {
+            "enzyme_uid": "R2ANONODE01",
+            "host_evidence_source": "UNRESOLVED",
+            "reasons": ["UniProtKB:ConnectError", "KEGG:ConnectError"],
+            "frozen_map_error": "uid has no row in the frozen reviewed UID map",
+        }
+        ev = EV.EvidenceRecord(stage="microbe", action="microbe_selection",
+                               data={"unresolved_host_ledger": [ledger_entry]},
+                               timestamp="2026-09-09T00:00:00+00:00")
+        originals = (MR.map_enzyme_hosts,)
+        def boom(*args, **kwargs):
+            raise AssertionError("§8: UNRESOLVED conversion must not re-query")
+        MR.map_enzyme_hosts = boom
+        try:
+            records = MR.host_evidence_records_from_node_output([], [], [ev])
+        finally:
+            MR.map_enzyme_hosts = originals[0]
+        self.assertEqual(len(records), 1)
+        rec = records[0]
+        self.assertEqual(rec.host_resolution, "UNRESOLVED")
+        self.assertIsNone(rec.source_signature)
+        self.assertEqual(rec.host_evidence_source, ["UNRESOLVED"])
+        warnings = " ".join(rec.warnings)
+        self.assertIn("unresolved_host_ledger consumed from microbe_selection_node output",
+                      warnings)
+        self.assertIn("uid has no row in the frozen reviewed UID map", warnings)
+        S.validate_host_evidence(S.host_evidence_projection(rec))
+
+
+def _live_provenance(uid="R2ACARRY01", taxid=990001, name="Testus Communis",
+                     marker=b"r2a-carried-live-fixture", with_identity=True):
+    """节点输出形状的 live provenance。
+
+    with_identity=True：节点已把 §5/§6 的宿主 identity 结论（签名 / resolution / taxon /
+    name）随 state 现有承载键带到下游 —— Path L 的真实形态。
+    with_identity=False：只携带原始 reviewed 证据（§8 末段的“没有 host resolution/
+    signature”形态），此时转换层只允许按 §5 从已携带字段补齐签名；resolution 缺失必须
+    显式报错（不猜、不降级 UNRESOLVED）。
+    """
+    up = EV.UniProtReviewedHostEvidence(
+        source_url="https://rest.uniprot.org/uniprotkb/" + uid + ".json",
+        response_sha256=hashlib.sha256(marker).hexdigest(),
+        primary_accession=uid,
+        entry_type="UniProtKB reviewed (Swiss-Prot)",
+        scientific_organism_name=name,
+        ncbi_taxon_id=taxid,
+        lineage=["Bacteria"],
+        annotation_score=4.2,
+        protein_existence="1: evidence at protein level",
+    )
+    kwargs = {
+        "enzyme_uid": uid,
+        "uniprot_reviewed": up,
+        "resolution_route": "LIVE_UNIPROT_REVIEWED",
+    }
+    if with_identity:
+        kwargs.update({
+            "host_identity_source": "CONSTRUCTED_TAXON_ORGANISM",
+            "host_identity_source_signature": "taxon:%d|organism:%s" % (taxid, name.casefold()),
+            "host_resolution": "SPECIES",
+            "host_taxid": taxid,
+            "host_name": name,
+        })
+    return EV.EnzymeSourceProvenance(**kwargs)
+
+
+def _organism(provenances):
+    first = provenances[0]
+    taxid = first.host_taxid
+    name = first.host_name
+    if taxid is None and first.uniprot_reviewed is not None:
+        taxid = first.uniprot_reviewed.ncbi_taxon_id
+        name = first.uniprot_reviewed.scientific_organism_name
+    return EV.OrganismCandidate(
+        organism_uid=str(taxid),
+        ncbi_taxon_id=taxid,
+        organism_name=name,
+        supporting_enzyme_count=len(provenances),
+        per_enzyme_source_provenance=list(provenances),
+    )
+
+
+if __name__ == "__main__":
+    unittest.main(verbosity=2)
