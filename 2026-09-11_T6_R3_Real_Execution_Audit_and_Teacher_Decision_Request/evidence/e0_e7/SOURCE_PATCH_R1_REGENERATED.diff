+            step_host_annotations=[_step_ann(CONTRACT_TASKS[0], "U1", 1, "taxon:1|org:A", 111, "Org A",
+                                              traits=pred5)]))
+        raise AssertionError("F5 PREDICTED accepted")
+    except RouteAggregationError as e:
+        assert "F5" in str(e)
+
+
+
+# ---------- T5C-R2 真菌 fail-closed 与 MISSING 稳定性 ----------
+
+def _fungal_ann(task, uid, rank, traits):
+    return RouteStepHostAnnotation(reaction_task_id=task, enzyme_uid=uid, enzyme_rank=rank,
+        source_signature="taxon:9|org:F", host_taxid=999, host_name="Fungus F", host_resolution="SPECIES",
+        host_taxonomy_group="target_fungi", host_evidence_sources=["UNIPROT_REVIEWED"], traits=traits)
+
+
+def g01_fungal_all_observed_fail_closed():
+    try:
+        aggregate_route(RouteAggregationInput(route_id=CONTRACT_ROUTE_ID, ordered_reaction_task_ids=CONTRACT_TASKS[:1],
+            step_host_annotations=[_fungal_ann(CONTRACT_TASKS[0], "U1", 1, _fifteen("OBSERVED", "o"))]))
+        raise AssertionError("fungal OBSERVED accepted")
+    except RouteAggregationError as e:
+        assert "fungal" in str(e)
+
+
+def g02_fungal_all_predicted_fail_closed():
+    pred = {tid: (_trait(tid, "MISSING", None) if tid == "F5" else _trait(tid, "PREDICTED", f"p-{tid}"))
+            for tid in F_TRAITS}
+    try:
+        aggregate_route(RouteAggregationInput(route_id=CONTRACT_ROUTE_ID, ordered_reaction_task_ids=CONTRACT_TASKS[:1],
+            step_host_annotations=[_fungal_ann(CONTRACT_TASKS[0], "U1", 1, pred)]))
+        raise AssertionError("fungal PREDICTED accepted")
+    except RouteAggregationError as e:
+        assert "fungal" in str(e)
+
+
+def g03_fungal_identity_plus_observed_mixed_fail_closed():
+    ident = {tid: _trait(tid, "IDENTITY_ONLY", None, resolution="IDENTITY_ONLY") for tid in F_TRAITS}
+    obs = {**_fifteen("OBSERVED", "o")}
+    try:
+        aggregate_route(RouteAggregationInput(route_id=CONTRACT_ROUTE_ID, ordered_reaction_task_ids=CONTRACT_TASKS[:2],
+            step_host_annotations=[
+                _fungal_ann(CONTRACT_TASKS[0], "U1", 1, ident),
+                _fungal_ann(CONTRACT_TASKS[1], "U2", 1, obs)]))
+        raise AssertionError("fungal mixed accepted")
+    except RouteAggregationError as e:
+        assert "fungal" in str(e)
+
+
+def g04_fungal_identity_nonnull_value_fail_closed():
+    ident = {tid: _trait(tid, "IDENTITY_ONLY", None, resolution="IDENTITY_ONLY") for tid in F_TRAITS}
+    ident["F1"] = _trait("F1", "IDENTITY_ONLY", ["x"], resolution="IDENTITY_ONLY")
+    try:
+        aggregate_route(RouteAggregationInput(route_id=CONTRACT_ROUTE_ID, ordered_reaction_task_ids=CONTRACT_TASKS[:1],
+            step_host_annotations=[_fungal_ann(CONTRACT_TASKS[0], "U1", 1, ident)]))
+        raise AssertionError("fungal non-null value accepted")
+    except RouteAggregationError as e:
+        assert "non-null" in str(e)
+
+
+def g05_fungal_identity_species_resolution_fail_closed():
+    ident = {tid: _trait(tid, "IDENTITY_ONLY", None, resolution="IDENTITY_ONLY") for tid in F_TRAITS}
+    ident["F2"] = TraitEvidence(trait_id="F2", trait_value=None, trait_evidence_class="IDENTITY_ONLY",
+                                trait_resolution="SPECIES", trait_source="t", source_record_id="s",
+                                source_tool="t", trait_warning=[])
+    try:
+        aggregate_route(RouteAggregationInput(route_id=CONTRACT_ROUTE_ID, ordered_reaction_task_ids=CONTRACT_TASKS[:1],
+            step_host_annotations=[_fungal_ann(CONTRACT_TASKS[0], "U1", 1, ident)]))
+        raise AssertionError("fungal non-IDENTITY_ONLY resolution accepted")
+    except RouteAggregationError as e:
+        assert "resolution" in str(e)
+
+
+def g06_fungal_identity_normal_output_preserved():
+    ident = {tid: _trait(tid, "IDENTITY_ONLY", None, resolution="IDENTITY_ONLY") for tid in F_TRAITS}
+    out = aggregate_route(RouteAggregationInput(route_id=CONTRACT_ROUTE_ID, ordered_reaction_task_ids=CONTRACT_TASKS[:2],
+        step_host_annotations=[
+            _fungal_ann(CONTRACT_TASKS[0], "U1", 1, ident),
+            _fungal_ann(CONTRACT_TASKS[1], "U2", 1, ident)]))
+    assert all(t["trait_evidence_class"] == "IDENTITY_ONLY" for t in out["aggregates"][0]["traits"])
+    errs = _gschema_validate_oa(out["aggregates"][0])
+    assert not errs
+
+
+def _missing_set():
+    def _mk(rec, warn=None):
+        m = {}
+        for tid in F_TRAITS:
+            e = _trait(tid, "MISSING", None)
+            e.source_record_id = f"m{rec}|{tid}"
+            m[tid] = e
+        if warn:
+            for wk in warn:
+                m[wk[0]] = m[wk[0]].model_copy(deep=True)
+                m[wk[0]].trait_warning = m[wk[0]].trait_warning + [wk[1]]
+        return m
+    return [_mk("A"), _mk("B"), _mk("C", [("F1", "wC")])]
+
+
+def g07_three_missing_six_permutations_stable():
+    import itertools as _it
+    ms = _missing_set()
+    outs = set()
+    for perm in _it.permutations(ms):
+        anns = [_step_ann(CONTRACT_TASKS[0], f"U{i}", i, "taxon:1|org:A", 111, "Org A", traits=tk)
+                for i, tk in enumerate(perm, 1)]
+        o = aggregate_route(RouteAggregationInput(route_id=CONTRACT_ROUTE_ID,
+            ordered_reaction_task_ids=CONTRACT_TASKS[:1], step_host_annotations=anns))
+        outs.add(json.dumps(o["aggregates"][0]["traits"], sort_keys=True))
+    assert len(outs) == 1
+    tr = json.loads(list(outs)[0])
+    f1 = [x for x in tr if x["trait_id"] == "F1"][0]
+    assert "mA|F1" in f1["source_record_id"] and "wC" in f1["trait_warning"]
+
+
+def _conflict_set():
+    def _mk(base, rec):
+        tk = _fifteen("OBSERVED", base)
+        out = {}
+        for tid in F_TRAITS:
+            ev = tk[tid].model_copy(deep=True)
+            ev.trait_evidence_class = "CONFLICT"
+            ev.trait_value = [f"{base}-{tid}"]
+            ev.source_record_id = f"c{rec}|{tid}"
+            out[tid] = ev
+        return out
+    return [_mk("a", "1"), _mk("b", "2"), _mk("c", "3")]
+
+
+def g08_three_conflicts_six_permutations_stable():
+    import itertools as _it
+    cs = _conflict_set()
+    outs = set()
+    for perm in _it.permutations(cs):
+        anns = [_step_ann(CONTRACT_TASKS[0], f"U{i}", i, "taxon:1|org:A", 111, "Org A", traits=tk)
+                for i, tk in enumerate(perm, 1)]
+        o = aggregate_route(RouteAggregationInput(route_id=CONTRACT_ROUTE_ID,
+            ordered_reaction_task_ids=CONTRACT_TASKS[:1], step_host_annotations=anns))
+        outs.add(json.dumps(o["aggregates"][0]["traits"], sort_keys=True))
+    assert len(outs) == 1
+    tr = json.loads(list(outs)[0])
+    f1 = [x for x in tr if x["trait_id"] == "F1"][0]
+    assert f1["trait_evidence_class"] == "CONFLICT"
+    assert sorted(f1["trait_value"]) == ["a-F1", "b-F1", "c-F1"]
+    tokens = set(f1["source_record_id"].split("|"))
+    assert {"F1", "c1", "c2", "c3"} <= tokens
+
+
+def main():
+    results = []
+    for name, fn in sorted(globals().items()):
+        if (name.startswith("c") and name[1:3].isdigit() or name.startswith("t1")
+                or name.startswith("n0") or name.startswith("r0") or name.startswith("r1")
+                or name.startswith("g0")) and callable(fn):
+            try:
+                fn()
+                results.append(f"PASS {name}")
+            except Exception as e:
+                results.append(f"FAIL {name}: {type(e).__name__}: {e}")
+    print("\n".join(results))
+    print(f"TOTAL={len(results)}")
+    return 0 if all(r.startswith("PASS") for r in results) else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
