+# -*- coding: utf-8 -*-
+"""T6-R3A G5: reaction_smiles + reaction_sha256 成对冻结回归（S1/S2）。"""
+import hashlib
+import sys
+import unittest
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+sys.path.insert(0, str(ROOT))
+
+from src.schemas.evidence import CandidateReaction
+from src.tools.reaction_retriever import _mock_retrieve_dryrun
+
+S1 = "NCC(=O)O.O.O=O>>N.O=CC(=O)O.OO"
+S1_SHA = "19fe5b26e16a1a8ca60628be8718d3162cabded0299e2276a8503aec787bcf15"
+S2 = "CN1CCC[C@H]1c1ccc(O)nc1.O=O>>CN1CCC=C1c1ccc(O)nc1.OO"
+S2_SHA = "9737dd8c994296811f87278e33cc7c8b1743112ddf9ecb745ba6de1e1dc2971a"
+
+
+def sha(s):
+    return hashlib.sha256(s.encode("utf-8")).hexdigest()
+
+
+class TestG5PairContract(unittest.TestCase):
+    def test_frozen_s1_s2_sha_recompute(self):
+        self.assertEqual(sha(S1), S1_SHA)
+        self.assertEqual(sha(S2), S2_SHA)
+
+    def test_paired_construction_ok(self):
+        for s, h in ((S1, S1_SHA), (S2, S2_SHA)):
+            c = CandidateReaction(
+                reaction_smiles=s, reaction_sha256=h,
+                similarity_score=0.9, source="retrieved")
+            self.assertEqual(c.reaction_sha256, h)
+
+    def test_missing_sha_rejected(self):
+        with self.assertRaises(Exception):
+            CandidateReaction(reaction_smiles=S1, similarity_score=0.9)
+
+    def test_missing_smiles_rejected(self):
+        with self.assertRaises(Exception):
+            CandidateReaction(reaction_sha256=S1_SHA, similarity_score=0.9)
+
+    def test_mismatch_rejected(self):
+        with self.assertRaises(Exception):
+            CandidateReaction(
+                reaction_smiles=S1, reaction_sha256=S2_SHA,
+                similarity_score=0.9)
+
+    def test_non_lowercase_64hex_rejected(self):
+        with self.assertRaises(Exception):
+            CandidateReaction(
+                reaction_smiles=S1, reaction_sha256=S1_SHA.upper(),
+                similarity_score=0.9)
+        with self.assertRaises(Exception):
+            CandidateReaction(
+                reaction_smiles=S1, reaction_sha256="0" * 63,
+                similarity_score=0.9)
+
+    def test_mock_retrieve_pairs_every_row(self):
+        for c in _mock_retrieve_dryrun("CCO", 2):
+            self.assertEqual(c.reaction_sha256, sha(c.reaction_smiles))
+
+
+if __name__ == "__main__":
+    unittest.main()
