+# -*- coding: utf-8 -*-
+"""T6-R3A G2: 全仓唯一 T2B v3.2 PredictedReaction 契约测试。"""
+import re
+import sys
+import unittest
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+
+
+class TestG2UniquePredictedReaction(unittest.TestCase):
+    def test_single_definition_across_repo(self):
+        hits = []
+        for py in list(ROOT.glob("src/**/*.py")) + list(ROOT.glob("config/*.py")):
+            text = py.read_text(encoding="utf-8")
+            for m in re.finditer(r"class\s+PredictedReaction\b", text):
+                hits.append((str(py), m.start()))
+        self.assertEqual(len(hits), 1,
+            f"expected exactly one PredictedReaction definition, got {hits}")
+        self.assertIn("evidence.py", hits[0][0])
+
+    def test_no_legacy_or_compat_copies(self):
+        banned = re.compile(r"class\s+\w*(Legacy|Compat|V2|Old)\w*")
+        for py in list(ROOT.glob("src/**/*.py")) + list(ROOT.glob("config/*.py")):
+            for m in banned.finditer(py.read_text(encoding="utf-8")):
+                self.fail(f"banned compat copy {m.group(0)} in {py}")
+
+    def test_v32_fields_present_and_banned_fields_absent(self):
+        sys.path.insert(0, str(ROOT))
+        from src.schemas.evidence import PredictedReaction
+        for f in ("reaction_smiles", "prediction_rank", "prediction_score",
+                  "source_tag", "source_tool", "model_version", "provenance",
+                  "depth", "warnings"):
+            self.assertIn(f, PredictedReaction.model_fields)
+        for banned in ("confidence", "prediction_method"):
+            self.assertNotIn(banned, PredictedReaction.model_fields)
+
+    def test_v32_construction_ok_and_rank_depth_guarded(self):
+        sys.path.insert(0, str(ROOT))
+        from src.schemas.evidence import PredictedReaction, PredictionScore
+        ok = PredictedReaction(
+            reaction_smiles="CCO>>CC=O",
+            prediction_rank=1,
+            prediction_score=PredictionScore(
+                raw_score=0.0,
+                score_semantics="rule_based_envmicro_rank_only_no_probability_score",
+                is_calibrated_probability=False),
+            source_tag="biotransformer_envmicro",
+            source_tool="biotransformer_envmicro",
+            model_version="biotransformer_3.0_envmicro",
+            provenance="unit-test",
+            depth=1,
+            parent_node_smiles="CCO",
+            parent_node_depth=0,
+            warnings=["not a probability"],
+        )
+        self.assertEqual(ok.prediction_rank, 1)
+        self.assertEqual(ok.depth, 1)
+        with self.assertRaises(Exception):
+            PredictedReaction(
+                reaction_smiles="CCO>>CC=O", prediction_rank=0,
+                prediction_score=PredictionScore(raw_score=0.0),
+                source_tag="t", provenance="unit-test", depth=1)
+        with self.assertRaises(Exception):
+            PredictedReaction(
+                reaction_smiles="CCO>>CC=O", prediction_rank=1,
+                prediction_score=PredictionScore(raw_score=0.0),
+                source_tag="t", provenance="unit-test", depth=0)
+
+
+if __name__ == "__main__":
+    unittest.main()
