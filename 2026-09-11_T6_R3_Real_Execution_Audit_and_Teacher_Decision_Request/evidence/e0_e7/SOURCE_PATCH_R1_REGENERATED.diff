+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+"""T6-R3A-R1 等效 pytest runner（环境无 pytest，用 unittest discover 等效执行）。
+
+运行 R3A 原 16 项（test_t6r3a_*.py）+ R1 新增（test_t6r3ar1_*.py）。
+同一测试逻辑，不静默跳过任何旧测试（§10：环境缺 pytest 可用等价 runner）。
+"""
+import sys
+import unittest
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+
+
+def main():
+    loader = unittest.TestLoader()
+    suite = unittest.TestSuite()
+    for pattern in ("test_t6r3a_*.py", "test_t6r3ar1_*.py"):
+        suite.addTests(loader.discover(
+            start_dir=str(ROOT / "tests"),
+            pattern=pattern,
+            top_level_dir=str(ROOT),
+        ))
+    runner = unittest.TextTestRunner(verbosity=2)
+    result = runner.run(suite)
+    return 0 if result.wasSuccessful() else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
