+def _provenance(uid, taxid, name, route="LIVE_UNIPROT_REVIEWED", signature=None,
+                resolution="SPECIES"):
+    if route != "LIVE_UNIPROT_REVIEWED":
+        return EV.EnzymeSourceProvenance(enzyme_uid=uid, resolution_route=None)
+    up = EV.UniProtReviewedHostEvidence(
+        source_url="https://rest.uniprot.org/uniprotkb/%s.json" % uid,
+        response_sha256=hashlib.sha256(("r2a-teacher-regression-" + uid).encode()).hexdigest(),
+        primary_accession=uid,
+        entry_type="UniProtKB reviewed (Swiss-Prot)",
+        scientific_organism_name=name,
+        ncbi_taxon_id=taxid,
+        lineage=["Bacteria"],
+        annotation_score=4.0,
+        protein_existence="1: evidence at protein level",
+    )
+    return EV.EnzymeSourceProvenance(
+        enzyme_uid=uid, uniprot_reviewed=up, resolution_route=route,
+        host_identity_source="CONSTRUCTED_TAXON_ORGANISM",
+        host_identity_source_signature=(
+            signature or "taxon:%d|organism:%s" % (taxid, name.casefold())),
+        host_resolution=resolution,
+        host_taxid=taxid, host_name=name)
+
+
+def _ranked(uid, rank):
+    return EV.RankedEnzyme(uid=uid, score=round(0.9 - 0.01 * rank, 4), rank=rank,
+                           ensemble_ci=(0.8, 0.95))
+
