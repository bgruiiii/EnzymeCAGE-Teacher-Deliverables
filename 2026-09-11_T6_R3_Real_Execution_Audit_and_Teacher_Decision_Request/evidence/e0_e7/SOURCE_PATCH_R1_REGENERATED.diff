+        self.assertEqual(len(by_uid), 2)
+        real_agg, real_item = by_uid["A0A011QK89"]
+        self.assertEqual(real_item["resolution_route"], "FROZEN_REVIEWED_UID_MAP_FALLBACK")
+        self.assertEqual(real_item["host_identity_source_signature"], "proteome:UP000022141")
+        self.assertEqual(real_item["host_resolution"], "EXACT_STRAIN")
+        self.assertIsNone(real_item["live_accession"])
+        synth_agg, synth_item = by_uid["R2AMERGEN3"]
+        self.assertEqual(synth_item["resolution_route"], "LIVE_UNIPROT_REVIEWED")
+        self.assertEqual(synth_item["host_identity_source_signature"],
+                         "taxon:522306|organism:accumulibacter regalis")
+        self.assertEqual(real_agg, synth_agg)
+        self.assertIsNone(real_agg["host_identity_source_signature"])
+        self.assertIn("signature=null", real_agg["aggregation_notes"])
+        self.assertEqual(synth_item["host_resolution"], "SPECIES")
+        self.assertEqual(real_agg["organism_uid"], synth_agg["organism_uid"])
+        self.assertEqual(real_agg["ncbi_taxon_id"], 522306)
