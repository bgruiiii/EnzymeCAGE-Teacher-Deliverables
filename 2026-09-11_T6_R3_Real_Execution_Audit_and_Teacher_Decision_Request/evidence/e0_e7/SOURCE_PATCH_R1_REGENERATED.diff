+"""Production entrypoint for the frozen depending BBD v3.2 runtime."""
+
+from __future__ import annotations
+
+import importlib.util
+import os
+from pathlib import Path
+from types import ModuleType
+
+_MODULE: ModuleType | None = None
+
+
+def _runtime_root() -> Path:
+    value = os.environ.get("DEPENDING_V32_RUNTIME_ROOT")
+    if not value:
+        raise RuntimeError("DEPENDING_V32_RUNTIME_ROOT is required")
+    root = Path(value).resolve()
+    if not root.is_dir():
+        raise RuntimeError("DEPENDING_V32_RUNTIME_ROOT is not a directory")
+    return root
+
+
+def _load() -> ModuleType:
+    global _MODULE
+    if _MODULE is not None:
+        return _MODULE
+    path = _runtime_root() / "reaction_analogy" / "single_smiles_v32.py"
+    spec = importlib.util.spec_from_file_location("depending_frozen_single_smiles_v32", path)
+    if spec is None or spec.loader is None:
+        raise RuntimeError("unable to load frozen depending v3.2 adapter")
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    _MODULE = module
+    return module
+
+
+def verify_runtime_assets() -> None:
+    module = _load()
+    error = module._verify_asset_identity(str(_runtime_root()))
+    if error:
+        raise RuntimeError(error)
+
+
+def predict_reactions(substrate_smiles: str, top_k: int = 10, max_depth: int = 1):
+    """Run fresh three-engine generation through the audited frozen adapter."""
+    module = _load()
+    return module.predict_reactions(
+        substrate_smiles, top_k=top_k, max_depth=max_depth,
+        repo_root=str(_runtime_root()),
+    )
