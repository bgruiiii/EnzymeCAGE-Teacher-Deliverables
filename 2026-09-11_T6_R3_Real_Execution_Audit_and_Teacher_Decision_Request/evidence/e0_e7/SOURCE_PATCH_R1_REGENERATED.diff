+# -*- coding: utf-8 -*-
+"""T6-R3A-R2A §7 + §8：三条宿主证据路径必须走真实 production 节点，且下游只转换节点输出。
+
+纪律：
+- 每模式一个 fresh 子进程（§7「fresh process 或显式安全清 cache」）；不引入清缓存后门；
+- transport 全部冻结：Path L 注入 R3A-R1 的 4 份 raw UniProt bytes（本任务不重新联网），
+  Path F/U 抛可控网络错误；KEGG 仅独立补充；
+- 断言只用**节点返回**的现有键（microbe/organism candidates、evidence_chain、
+  uncertainty_flags）+ 在 loader 之外独立复算的冻结实物（raw bytes / 冻结 map 行）；
+- §8：转换入口不得再次调用网络 mapper（instrument 计数增量必须为 0）。
+"""
+import csv
+import hashlib
+import json
+import os
+import sys
+import unittest
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+for p in (str(ROOT), str(ROOT / "tests")):
+    if p not in sys.path:
+        sys.path.insert(0, p)
+
+import _t6r3ar2a_support as S  # noqa: E402
+from src.schemas import evidence as EV  # noqa: E402
+from src.tools import microbe_recommender as MR  # noqa: E402
+
+MAP_PATH = S.uid_map_path()
+ABSENT_UID = "R2ASYNTH00ABSENT"          # 合成 UID：确实不在冻结 map 内（§7 Path U 的受控失败）
+NODE_RETURN_KEYS = ["evidence_chain", "microbe_candidates", "organism_candidates",
+                    "uncertainty_flags"]
+
+_PAYLOADS = {}
+
+
+def payload(mode):
+    """按模式在 fresh 进程跑真实节点（结果 memo 复用，进程本身仍是一次性隔离的）。"""
+    if mode in _PAYLOADS:
+        return _PAYLOADS[mode]
+    if MAP_PATH is None:
+        raise unittest.SkipTest("frozen reviewed UID map not locatable")
+    env_extra = {}
+    env_pop = ()
+    if mode == "U":
+        env_pop = ("C8_UID_SOURCE_MAP_PATH",)          # map 未配置 → 显式失败
+    else:
+        env_extra["C8_UID_SOURCE_MAP_PATH"] = str(MAP_PATH)
+    if mode == "ABSENT":
+        env_extra["R2A_QUERY_UIDS"] = ",".join([S.UIDS[0], ABSENT_UID])
+    _PAYLOADS[mode] = S.run_worker(mode, env_extra=env_extra, env_pop=env_pop)
+    return _PAYLOADS[mode]
+
+
+# ── 冻结实物在 loader 之外的独立复算 ─────────────────────────────────────────
+_MAP_ROWS = {}
+
+
+def _scan_map_lines(lines):
+    path = S.uid_map_path()
+    want = set(int(n) for n in lines)
+    found = {}
+    with open(str(path), "rb") as fh:
+        header = None
+        for line_no, raw in enumerate(fh, start=1):
+            if line_no == 1:
+                header = next(csv.reader([raw.decode("utf-8")]))
+                continue
+            if line_no in want:
+                row = next(csv.reader([raw.decode("utf-8")]))
+                found[line_no] = {
+                    "cols": {name: (row[i].strip() if i < len(row) else "")
+                             for i, name in enumerate(header)},
+                    "row_sha256": hashlib.sha256(raw).hexdigest(),
+                }
+            if line_no > max(want):
+                break
+    return found
+
+
+def map_row(line):
+    line = int(line)
+    if line not in _MAP_ROWS:
+        _MAP_ROWS.update(_scan_map_lines([line]))
+    return _MAP_ROWS[line]
+
+
+def raw_facts():
+    """Path L 的宿主事实基准：直接解析 R1 冻结 raw response bytes（不经 production 代码）。"""
+    out = {}
+    for uid, body in S.frozen_bytes_map().items():
+        payload_json = json.loads(body.decode("utf-8"))
+        out[uid] = {
+            "taxid": payload_json["organism"]["taxonId"],
+            "name": payload_json["organism"]["scientificName"],
+            "accession": payload_json["primaryAccession"],
