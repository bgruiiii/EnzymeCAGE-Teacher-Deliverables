@@ -0,0 +1,220 @@
+# -*- coding: utf-8 -*-
+"""T6-R3A-R2A §7：真实 microbe_selection_node 的三条宿主证据路径 worker（fresh 进程）。
+
+由 tests/_t6r3ar2a_support.run_worker 以子进程方式调用（每个模式独立进程 ⇒ 进程级 lazy
+cache 天然隔离，不需要任何 test-only 清缓存后门）。本 worker 全程不访问公网：
+- L      : live UniProt 命中（R1 冻结 raw bytes 注入 transport），KEGG 冻结无响应；
+- F      : UniProt 对 4 UID 全抛可控网络错误，冻结 reviewed UID map 可用；
+- U      : live 抛错且冻结 map 不可用（C8_UID_SOURCE_MAP_PATH 未配置）；
+- ABSENT : live 抛错 + map 可用但查询 UID 不在表内（显式无行 → UNRESOLVED）。
+stdout 输出 JSON；stderr 只写日志。
+"""
+import json
+import logging
+import os
+import sys
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+if str(ROOT) not in sys.path:
+    sys.path.insert(0, str(ROOT))
+sys.path.insert(0, str(ROOT / "tests"))
+
+import httpx  # noqa: E402
+
+import _t6r3ar2a_support as S  # noqa: E402
+from src.schemas import evidence as EV  # noqa: E402
+from src.state import EnzymeCrewState  # noqa: E402
+from src.tools import microbe_recommender as MR  # noqa: E402
+from src.nodes.microbe_selection_node import microbe_selection_node  # noqa: E402
+
+logging.basicConfig(level=logging.INFO, stream=sys.stderr)
+
+MODE = (os.environ.get("R2A_WORKER_MODE") or "L").strip().upper()
+QUERY_UIDS = [u for u in (os.environ.get("R2A_QUERY_UIDS") or "").split(",") if u] or S.UIDS
+
+
+def _install_transport():
+    """冻结 transport：只注入 R1 raw bytes 或抛可控错误，永不真连网络。"""
+    calls = {"uniprot": 0, "kegg": 0, "other": 0}
+    raw = S.frozen_bytes_map() if MODE in ("L",) else None
+
+    def request_bytes(url):
+        for uid in S.UIDS:
+            if url == MR._uniprot_url(uid):
+                calls["uniprot"] += 1
+                if raw is None:
+                    raise httpx.ConnectError(
+                        "R2A frozen transport: controlled simulated UniProt network failure"
+                    )
+                return raw[uid]
+        if url.startswith("https://rest.kegg.jp/"):
+            calls["kegg"] += 1
+            if MODE == "L":
+                return b""            # KEGG 冻结空响应（multiplicity=0 → state=missing）
+            raise httpx.ConnectError("R2A frozen transport: controlled simulated KEGG failure")
+        calls["other"] += 1
+        raise httpx.ConnectError("R2A frozen transport: no fixture for " + url)
+
+    MR._request_bytes = request_bytes
+    return calls
+
+
+def _mapper_instrument():
+    """§8 计数：节点跑过一次后，下游转换若再触网/再扫表，计数必然非 0。"""
+    counters = {"map_enzyme_hosts": 0, "query_uniprot_reviewed": 0,
+                "request_bytes": 0, "frozen_map_scan": 0}
+    originals = (MR.map_enzyme_hosts, MR.query_uniprot_reviewed, MR._request_bytes,
+                 MR._frozen_map_scan)
+
+    def wrap(name, fn):
+        def inner(*a, **k):
+            counters[name] += 1
+            return fn(*a, **k)
+        return inner
+
+    MR.map_enzyme_hosts = wrap("map_enzyme_hosts", originals[0])
+    MR.query_uniprot_reviewed = wrap("query_uniprot_reviewed", originals[1])
+    MR._request_bytes = wrap("request_bytes", originals[2])
+    MR._frozen_map_scan = wrap("frozen_map_scan", originals[3])
+
+    def snapshot():
+        return dict(counters)
+
+    def restore():
+        (MR.map_enzyme_hosts, MR.query_uniprot_reviewed, MR._request_bytes,
+         MR._frozen_map_scan) = originals
+    return snapshot, restore
+
+
+def main():
+    transport_calls = _install_transport()
+    uid_map_configured = bool((os.environ.get("C8_UID_SOURCE_MAP_PATH") or "").strip())
+    before_load = MR.frozen_map_cache_stats()
+
+    ranked = [
+        EV.RankedEnzyme(uid=uid, score=round(0.9 - 0.01 * i, 4), rank=i + 1,
+                        ensemble_ci=(round(0.85 - 0.01 * i, 4), round(0.95 - 0.01 * i, 4)))
+        for i, uid in enumerate(QUERY_UIDS)
+    ]
+    state = EnzymeCrewState(user_query="T6-R3A-R2A §7 three-path worker mode=" + MODE)
+    state = state.model_copy(update={"ranked_enzymes": ranked})
+
+    node_out = microbe_selection_node(state)   # ← 真实 production 节点
+    after_node = MR.frozen_map_cache_stats()
+    transport_after_node = dict(transport_calls)
+
+    microbe_candidates = node_out["microbe_candidates"]
+    organism_candidates = node_out["organism_candidates"]
+    evidence_chain = node_out["evidence_chain"]
+
+    # §8：下游 host evidence 只消费节点输出；转换前后 instrument 网络 mapper/表扫描增量必须为 0
+    snapshot, restore = _mapper_instrument()
+    base = snapshot()
+    records = MR.host_evidence_records_from_node_output(
+        microbe_candidates=microbe_candidates,
+        organism_candidates=organism_candidates,
+        evidence_records=[e for e in evidence_chain if e.stage == "microbe"],
+    )
+    after = snapshot()
+    restore()
+    conversion_delta = {k: after[k] - base[k] for k in after}
+
+    projections, route_by_uid = [], {}
+    for rec in records:
+        projections.append(S.host_evidence_projection(rec))
+        S.validate_host_evidence(S.host_evidence_projection(rec))
+        route_by_uid[rec.enzyme_uid] = rec.resolution_route
+
+    microbe_ev = [e for e in evidence_chain if e.stage == "microbe"][-1]
+    payload = {
+        "mode": MODE,
+        "uid_map_env_configured": uid_map_configured,
+        "query_uids": list(QUERY_UIDS),
+        "cache_stats_before_load": before_load,
+        "cache_stats_after_node": after_node,
+        "transport_calls_after_node": transport_after_node,
+        "node_return_keys": sorted(node_out.keys()),
+        "microbe_candidates": [
+            {
+                "enzyme_uid": c.enzyme_uid,
+                "organism_name": c.organism_name,
+                "tax_id": c.tax_id,
+                "source_db": c.source_db,
+                "evidence_level": c.evidence_level,
+                "resolution_route": c.resolution_route,
+                "host_identity_source_signature": c.host_identity_source_signature,
+            }
+            for c in microbe_candidates
+        ],
+        "organism_candidates": [
+            {
+                "organism_uid": o.organism_uid,
+                "ncbi_taxon_id": o.ncbi_taxon_id,
+                "organism_name": o.organism_name,
+                "host_identity_source_signature": o.host_identity_source_signature,
+                "supporting_enzyme_count": o.supporting_enzyme_count,
+                "supporting_enzymes": [se.uid for se in o.supporting_enzymes],
+                "per_enzyme_identity": [
+                    {
+                        "enzyme_uid": p.enzyme_uid,
+                        "resolution_route": p.resolution_route,
+                        "host_identity_source": p.host_identity_source,
+                        "host_identity_source_signature": p.host_identity_source_signature,
+                        "host_resolution": p.host_resolution,
+                        "host_taxid": p.host_taxid,
+                        "host_name": p.host_name,
+                        "frozen_map_file": p.frozen_map_file,
+                        "frozen_map_line": p.frozen_map_line,
+                        "frozen_map_row_sha256": p.frozen_map_row_sha256,
+                        "frozen_map_table_sha256": p.frozen_map_table_sha256,
+                        "frozen_map_error": p.frozen_map_error,
+                        "mapping_confidence_raw": p.mapping_confidence_raw,
+                        "carries_live_reviewed_evidence": p.uniprot_reviewed is not None,
+                        # §5：evidence record identity（accession / URL / response SHA）与
