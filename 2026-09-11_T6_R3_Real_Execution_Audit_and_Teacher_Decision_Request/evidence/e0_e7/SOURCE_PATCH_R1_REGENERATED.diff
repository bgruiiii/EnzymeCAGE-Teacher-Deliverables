@@ -0,0 +1,81 @@
+# -*- coding: utf-8 -*-
+"""T6-R3A-R1 V13 worker: 独立进程运行冻结 T5C-R2 真实 aggregate_route.
+
+为什么独立进程: probe 树 (base+T5B+T5C patch) 与本 STAGED 树都有顶层 src 包且
+evidence.py 模型集不同 (probe 无 HostEvidenceRecord); 同进程 import 两棵树的
+src.* 会互相污染 sys.modules。本 worker 在干净进程中只挂 probe 树, 聚合完成后
+以 JSON 打印到 stdout, 由 test_t6r3ar1_aggregation_gschema.py 断言。
+
+用法: python _t6r3ar1_aggregation_worker.py <probe_dir> <return_dir>
+输出: 单行 JSON {"ordered": [...], "result": {aggregate_route 完整输出}}
+输入: <return_dir>/PRODUCTION_HOST_MAPPING_RESULTS.jsonl (production mapper 真实输出)
+"""
+import json
+import sys
+from pathlib import Path
+
+probe = Path(sys.argv[1])
+ret = Path(sys.argv[2])
+sys.path.insert(0, str(probe))
+
+from src.schemas.evidence import (  # noqa: E402
+    RouteAggregationInput, RouteStepHostAnnotation, TraitEvidence)
+from src.tools.trait_query import F_TRAITS  # noqa: E402
+from src.utils import route_step_organism_aggregator as agg  # noqa: E402
+
+FUNGAL = "target_fungi"
+ROUTE_ID = "R-t6r3ar1-phase7-threestep"
+STEP_ORDER = ["S3", "S4", "S5", "S6", "S7", "S8"]
+
+
+def main():
+    recs = {}
+    for line in (ret / "PRODUCTION_HOST_MAPPING_RESULTS.jsonl").read_text(
+            encoding="utf-8").splitlines():
+        if line.strip():
+            d = json.loads(line)
+            recs[d["smoke_record_id"]] = d
+    ordered = sorted({recs[s]["reaction_task_id"] for s in STEP_ORDER})
+
+    anns = []
+    for srid in STEP_ORDER:
+        r = recs[srid]
+        he = r["production_host_evidence"]
+        traits = {}
+        for tid in F_TRAITS:
+            if r["host_taxonomy_group"] == FUNGAL:
+                ev = TraitEvidence(
+                    trait_id=tid, trait_evidence_class="IDENTITY_ONLY",
+                    trait_resolution="IDENTITY_ONLY", trait_value=None,
+                    source_record_id=f"uniprotkb_reviewed:{r['enzyme_uid']}")
+            else:
+                ev = TraitEvidence(
+                    trait_id=tid, trait_evidence_class="MISSING",
+                    trait_resolution="UNRESOLVED", trait_value=None,
+                    source_record_id=f"uniprotkb_reviewed:{r['enzyme_uid']}",
+                    trait_warning=["no_trait_evidence_in_r1_scope"])
+            traits[tid] = ev
+        anns.append(RouteStepHostAnnotation(
+            reaction_task_id=r["reaction_task_id"],
+            enzyme_uid=r["enzyme_uid"],
+            enzyme_rank=1,
+            source_signature=he["source_signature"],
+            host_taxid=he["host_taxid"],
+            host_name=he["host_name"],
+            host_resolution=he["host_resolution"],
+            host_taxonomy_group=r["host_taxonomy_group"],
+            host_evidence_sources=list(he["host_evidence_source"]),
+            traits=traits,
+        ))
+
+    inp = RouteAggregationInput(route_id=ROUTE_ID,
+                                ordered_reaction_task_ids=ordered,
+                                step_host_annotations=anns)
+    result = agg.aggregate_route(inp)
+    out = {"ordered": ordered, "aggregator_file": str(Path(agg.__file__).resolve()),
+           "result": json.loads(json.dumps(result, ensure_ascii=False))}
+    print(json.dumps(out, ensure_ascii=False))
+
+
+if __name__ == "__main__":
+    main()
