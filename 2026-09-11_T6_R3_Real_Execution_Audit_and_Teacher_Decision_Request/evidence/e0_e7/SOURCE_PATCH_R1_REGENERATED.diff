+# tests/test_trait_filter_node_c8.py — T5B Trait 节点行为测试（无第三方依赖 runner）
+
+import csv
+import json
+import pathlib
+import sys
+
+PROJECT_ROOT = pathlib.Path(__file__).resolve().parent.parent
+sys.path.insert(0, str(PROJECT_ROOT))
+
+from src.state import EnzymeCrewState  # noqa: E402
+from src.schemas.evidence import OrganismCandidate, SupportingEnzyme  # noqa: E402
+from src.nodes.trait_filter_node import trait_filter_node  # noqa: E402
+
+CACHE = pathlib.Path("/tmp/t5b_test_cache")
+C8_ROOT = CACHE / "enzymecage_m4b_c8_1_lookup_index_delta_review_dependency_payload_rerun2_repack_fix_20260820"
+UID_MAP = pathlib.Path("/usrdata/EnzymeCAGE_data/EnzymeCAGE-master/HPC_Returned_Result_Summaries/enzymecage_m4b_c8_1_lookup_index_delta_review_dependency_payload_rerun1_20260820/_input_payload/enzymecage_m4b_c8_1_dependency_payload_20260820/inputs/uid_to_source/uid_to_source_keep_bacteria_fungi_archaea.csv")
+T1_GPU = CACHE / "enzymecage_three_module_t1_r2_r1_pool100_cpu_metadata_validator_correction_20260905" / "GPU_FORMAL_ENTRY_RESULTS.jsonl"
+
+
+def _fixture_candidates():
+    uids = sorted({r["uid"] for line in open(T1_GPU, encoding="utf-8")
+                   for r in json.loads(line)["wrapper"].get("ranked_enzymes", [])})
+    idx = {}
+    with open(UID_MAP, encoding="utf-8") as f:
+        for row in csv.DictReader(f):
+            idx.setdefault(row["UniprotID"], []).append(row)
+    cands = []
+    for u in uids:
+        row = idx.get(u, [{}])[0]
+        taxid = int(row.get("TaxID") or 0)
+        cands.append(OrganismCandidate(
+            organism_uid=str(taxid), ncbi_taxon_id=taxid,
+            organism_name=row.get("organism_name") or "unknown",
+            supporting_enzymes=[SupportingEnzyme(uid=u, score=1.0, rank=1)],
+            supporting_enzyme_count=1, default_order_rank=len(cands) + 1))
+    return cands
+
+
+def _state(cands=None):
+    return EnzymeCrewState(user_query="", organism_candidates=cands if cands is not None else _fixture_candidates())
+
+
+def n1_annotations_and_records_consistent():
+    from src.tools.trait_query import build_trait_annotations, trait_records_from_annotations
+    out = trait_filter_node(_state())
+    assert out["trait_filter_passed"] is True
+    annotations, _ = build_trait_annotations(_state().organism_candidates)
+    assert len(annotations) == 17
+    recs = trait_records_from_annotations(annotations)
+    assert [r.model_dump() for r in recs] == [r.model_dump() for r in out["trait_records"]]
+    assert "trait_annotations" not in out
+
+
+def n2_fail_closed_on_bad_asset():
+    import importlib
+    import src.tools.trait_query as tq
+    nf = importlib.import_module("src.nodes.trait_filter_node")
+    orig = nf.build_trait_annotations
+    def bad(candidates, **kw):
+        raise tq.C8AssetError("identity failed for test")
+    nf.build_trait_annotations = bad
+    try:
+        out = trait_filter_node(_state())
+    finally:
+        nf.build_trait_annotations = orig
+    assert out["fail_closed"] is True
+    assert "asset identity failed" in out["error"]
+    assert out["trait_records"] == []
+
+
+def n3_candidates_unchanged():
+    cands = _fixture_candidates()
+    before = [(c.organism_uid, c.default_order_rank, [s.uid for s in c.supporting_enzymes]) for c in cands]
+    trait_filter_node(_state(cands))
+    after = [(c.organism_uid, c.default_order_rank, [s.uid for s in c.supporting_enzymes]) for c in cands]
+    assert before == after
+
+
+def n4_empty_candidates_none():
+    out = trait_filter_node(_state([]))
+    assert "trait_annotations" not in out and out["trait_records"] == []
+    assert out["trait_filter_passed"] is None
+
+
+def n5_evidence_action_and_counts():
+    out = trait_filter_node(_state())
+    ev = out["evidence_chain"][-1]
+    assert ev.action == "c8_trait_annotation_readonly"
+    assert ev.data["mapped_uids"] == 17 and ev.data["not_mapped_uids"] == []
+    assert ev.data["observed_trait_count"] > 0 and ev.data["missing_trait_count"] > 0
+    assert ev.data["f1_f15_complete_per_mapped_source"] is True
+
+
+def n6_no_sort_or_rerank_in_output():
+    out = trait_filter_node(_state())
+    assert "trait_score" not in json.dumps([r.model_dump() for r in out["trait_records"]], ensure_ascii=False)
+
+
+def main():
+    results = []
+    for name, fn in sorted(globals().items()):
+        if name.startswith("n") and callable(fn):
+            try:
+                fn()
+                results.append(f"PASS {name}")
+            except Exception as e:
+                results.append(f"FAIL {name}: {type(e).__name__}: {e}")
+    print("\\n".join(results))
+    print(f"TOTAL={len(results)}")
+    return 0 if all(r.startswith("PASS") for r in results) else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
