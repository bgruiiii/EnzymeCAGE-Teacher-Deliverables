+    """官方 G-SCHEMA Draft202012 子对象验证器（与阶段7 产出同一构造）。"""
+    import jsonschema
+    gschema = json.loads((gdir / "THREE_MODULE_EVIDENCE_CHAIN_SCHEMA.json")
