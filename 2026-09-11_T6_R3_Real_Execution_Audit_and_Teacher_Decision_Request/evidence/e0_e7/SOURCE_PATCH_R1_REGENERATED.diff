+# -*- coding: utf-8 -*-
+"""T6-R3A-R1 §10 R1新增: V13 route aggregation + V14 G-SCHEMA 官方验证测试。
+
+覆盖（R1 新增 aggregation / G-SCHEMA 要求）:
+- V13: S3—S8 真实冻结 T5C-R2 aggregate_route 输出 2 host aggregates 各覆盖
+  3/3 reaction_task_id; route union 3/3 无 double counting; S1/S2（M3 全反应
+  召回探针, 不属于 route 步骤）不混入; 真菌 aggregate 全 IDENTITY_ONLY 红线
+  （不伪造 trait value）, 细菌 aggregate 诚实 MISSING 降级（R1 范围无 trait
+  证据）。
+- V14: 8 条 production host evidence 全部通过官方 G-SCHEMA Draft202012 子对象
+  $ref #/$defs/hostEvidence; 2 个 organismAggregate 通过 $ref
+  #/$defs/organismAggregate; 官方 VALID_EXAMPLE 基线 0 错误且 15 negatives
+  全部被拒绝。
+
+aggregation 在独立 worker 进程执行（tests/_t6r3ar1_aggregation_worker.py）:
+probe 树（base+T5B+T5C patch, 冻结 T5C-R2 aggregator）与本树都有顶层 src 包,
+同进程 import 两棵树会污染 sys.modules, 故以 subprocess 隔离, JSON stdout 回传。
+目录可用环境变量 T6R3AR1_PROBE_DIR / T6R3AR1_RETURN_DIR / T6R3AR1_GSCHEMA_DIR
+覆盖; 缺失时 skipTest（不得静默通过）。
+"""
+import json
+import os
+import subprocess
+import sys
+import unittest
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+sys.path.insert(0, str(ROOT))
+
+FALLBACK_PROBE = Path("/tmp/t6r3ar1_phase7_probe_t5c_only")
+FALLBACK_RETURN = Path(
+    "/usrdata/EnzymeCAGE_data/EnzymeCAGE-master/HPC_Returned_Result_Summaries/"
+    "enzymecage_three_module_t6_r3a_r1_uniprot_host_provenance_runtime_wiring_"
+    "delivery_correction_20260909"
+)
+FALLBACK_GSCHEMA = Path(
+    "/tmp/t6r3ar1_gschema_Z0FGnC/"
+    "G_SCHEMA_THREE_MODULE_EVIDENCE_CHAIN_V0_1_2026-09-05"
+)
+WORKER = Path(__file__).resolve().parent / "_t6r3ar1_aggregation_worker.py"
+
+# ── 2026-09-09 冻结值: S3—S8 的两个宿主（production mapper 冻结 transport 输出）──
+FUNGAL_SIG = "uniprotkb_reviewed:A0A017SP50"    # Aspergillus ruber (strain CBS 135680)
+BACTERIAL_SIG = "uniprotkb_reviewed:A0A011QK89"  # Accumulibacter regalis
+N_EXPECTED_TASKS = 3   # S3—S8 → 3 个 reaction_task_id（每 task 两步两酶）
+N_F_TRAITS = 15        # F1—F15 全量 trait 槽位
+
+_WORKER_CACHE = {}
+
+
+def _resolve_dir(env_name: str, fallback: Path):
+    env = os.environ.get(env_name, "")
+    p = Path(env) if env else fallback
+    return p if p.is_dir() else None
+
+
+def _worker_payload(tc: unittest.TestCase) -> dict:
+    """独立进程跑冻结 T5C-R2 aggregate_route（结果跨测试类缓存一次）。"""
+    probe = _resolve_dir("T6R3AR1_PROBE_DIR", FALLBACK_PROBE)
+    ret = _resolve_dir("T6R3AR1_RETURN_DIR", FALLBACK_RETURN)
+    if probe is None:
+        tc.skipTest("probe tree not available; set T6R3AR1_PROBE_DIR")
+    if ret is None:
+        tc.skipTest("return dir not available; set T6R3AR1_RETURN_DIR")
+    if not WORKER.exists():
+        tc.skipTest(f"worker missing: {WORKER}")
+    if "payload" not in _WORKER_CACHE:
+        proc = subprocess.run(
+            [sys.executable, "-B", str(WORKER), str(probe), str(ret)],
+            capture_output=True, text=True, timeout=180)
+        if proc.returncode != 0:
+            raise AssertionError(
+                "aggregation worker failed:\n" + proc.stderr[-2000:])
