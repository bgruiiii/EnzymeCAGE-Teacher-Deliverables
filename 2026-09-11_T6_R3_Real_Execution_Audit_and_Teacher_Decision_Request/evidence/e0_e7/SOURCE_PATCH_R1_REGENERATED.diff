+    "enzymecage_three_module_t6_r3a_r2a_microbe_node_output_uid_map_fallback_host_signature_"
+    "correction_20260909/frozen_inputs/gschema"
+)
+GS_SCHEMA_SHA256 = (
+    "4d313d06bf95718a54c79e002989445f554f730a9157a1385a620ddaccf34797"
+)
+HOST_EVIDENCE_FIELDS = (
